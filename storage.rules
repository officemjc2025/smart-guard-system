rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // 1. Enforce authentication for all storage actions
      allow read: if request.auth != null;
      
      // 2. Limit uploads to authenticated users and reject any file exceeding 2MB
      allow write: if request.auth != null && request.resource.size <= 2 * 1024 * 1024;
    }
  }
}
