# Drive OAuth credentials and root folder ID are Secret Manager secrets.
# Never place their values in this file.
# Required secret names:
# GOOGLE_DRIVE_CLIENT_ID
# GOOGLE_DRIVE_CLIENT_SECRET
# GOOGLE_DRIVE_REFRESH_TOKEN
# GOOGLE_DRIVE_ROOT_FOLDER_ID
# GOOGLE_DRIVE_VIEWER_EMAIL grants read access to a specific Google account.
GOOGLE_DRIVE_VIEWER_EMAIL=

# ขีดจำกัดสูงสุดของไฟล์ภาพอัปโหลด (หน่วยไบต์ - ค่าเริ่มต้น 2 MB)
MEDIA_MAX_UPLOAD_BYTES=2097152

# ชนิดของ MIME Type ที่อนุญาตให้อัปโหลดได้ (แยกด้วยจุลภาค)
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Site ID หลักสำหรับ Fallback
MEDIA_DEFAULT_SITE_ID=site-01
