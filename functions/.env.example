# Google Drive Root Folder ID (ผู้ดูแลระบบต้องแชร์สิทธิ์ Editor ให้ Service Account ด้วย)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ขีดจำกัดสูงสุดของไฟล์ภาพอัปโหลด (หน่วยไบต์ - ค่าเริ่มต้น 2 MB)
MEDIA_MAX_UPLOAD_BYTES=2097152

# ชนิดของ MIME Type ที่อนุญาตให้อัปโหลดได้ (แยกด้วยจุลภาค)
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Site ID หลักสำหรับ Fallback
MEDIA_DEFAULT_SITE_ID=site-01
