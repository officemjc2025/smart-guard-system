rules_version = '2';
// ===============================================================
// Assumed critical data model (SPR-005)
// parkingCards/{card_id}: immutable card_id/site_id, canonical status,
// card type, active vehicle references, replacement/lost metadata.
// vehicleLogs/{log_id}: immutable log/card/site/entry identity and entry/exit data.
// auditLogs/{audit_id}: authenticated operator/account identity, site, card/log,
// state transition, server timestamp and optional reason; immutable after create.
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return ownProfileExists() && ownProfile().status == 'Active';
    }

    function isAdmin() {
      return isActiveUser() && ownProfile().role == 'Admin';
    }

    function canManageUnits() {
      return isActiveUser() && ownProfile().role in ['Admin', 'Manager'];
    }

    function canManageParkingCards() {
      return isActiveUser() && ownProfile().role in ['Admin', 'Manager'];
    }

    function canProcessVehicleExit() {
      return isActiveUser() && ownProfile().role in ['Guard', 'ShiftHead', 'Manager', 'Admin'];
    }

    function activeSiteId() {
      return ownProfileExists() && ('site_id' in ownProfile()) ? ownProfile().site_id : 'site-01';
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/systemSettings/authBootstrap);
    }

    function validParkingCard(data) {
      return data.keys().hasOnly([
               'firestore_document_id', 'card_id', 'site_id', 'card_number', 'card_number_normalized', 'qr_code_value', 'qr_code_normalized', 'card_type', 'status', 'status_normalized', 'status_original',
               'current_vehicle_plate', 'current_vehicle_log_id', 'current_vehicle_session_id', 'last_activity_at', 'member_id', 'lost_reason', 'lost_at', 'reported_by', 'reported_by_account_uid', 'related_vehicle_log_id',
               'replacement_card_id', 'replaced_by_card_id', 'replaced_by_document_id', 'replacement_for_card_id', 'replacement_for_document_id', 'replacement_reason', 'replacement_at', 'replacement_by', 'created_by', 'replacement_approved', 'replacement_approved_by',
               'replacement_approved_at', 'note', 'created_at', 'updated_at'
             ])
             && data.keys().hasAll(['card_id', 'site_id', 'card_number', 'qr_code_value', 'card_type', 'status', 'created_at', 'updated_at'])
             && data.card_id is string
             && data.site_id is string && data.site_id.size() > 0 && data.site_id.size() <= 64
             && data.card_number is string
             && data.card_number.size() > 0 && data.card_number.size() <= 64
             && data.card_number.matches('^[A-Za-z0-9 /_-]+$')
             && data.qr_code_value is string && data.qr_code_value.size() <= 256
             && data.card_type in ['Normal', 'Temporary', 'VIP', 'Resident', 'Contractor', 'Staff', 'Other']
             && data.status in ['Available', 'Reserved', 'Returned', 'InUse', 'In Use', 'Disabled', 'Suspended', 'Lost', 'Cancelled', 'Replaced', 'ReplacementApproved', 'Retired', 'VIP', 'ว่าง', 'ใช้งานอยู่', 'กำลังใช้งาน', 'VehicleInside', 'ระงับ', 'บัตรหาย']
             && (!('status_normalized' in data) || data.status_normalized in ['Available', 'Reserved', 'Returned', 'InUse', 'Disabled', 'Suspended', 'Lost', 'Cancelled', 'Replaced', 'ReplacementApproved', 'Retired', 'VIP'])
             && (data.card_type == 'VIP' ? (!('status_normalized' in data) || data.status_normalized == 'VIP') : (!('status_normalized' in data) || data.status_normalized != 'VIP'))
             && (!('firestore_document_id' in data) || (data.firestore_document_id is string && data.firestore_document_id.size() > 0 && data.firestore_document_id.size() <= 128))
             && (!('card_number_normalized' in data) || (data.card_number_normalized is string && data.card_number_normalized.size() <= 64))
             && (!('qr_code_normalized' in data) || (data.qr_code_normalized is string && data.qr_code_normalized.size() <= 256))
             && (!('status_original' in data) || (data.status_original is string && data.status_original.size() <= 64))
             && ((data.created_at is string && data.created_at.size() <= 64) || data.created_at is timestamp)
             && ((data.updated_at is string && data.updated_at.size() <= 64) || data.updated_at is timestamp)
             && (!('current_vehicle_plate' in data) || (data.current_vehicle_plate is string && data.current_vehicle_plate.size() <= 64))
             && (!('current_vehicle_log_id' in data) || (data.current_vehicle_log_id is string && data.current_vehicle_log_id.size() <= 128))
             && (!('current_vehicle_session_id' in data) || (data.current_vehicle_session_id is string && data.current_vehicle_session_id.size() <= 128))
             && (!('last_activity_at' in data) || (data.last_activity_at is string && data.last_activity_at.size() <= 64) || data.last_activity_at is timestamp)
             && (!('member_id' in data) || (data.member_id is string && data.member_id.size() <= 128))
             && (!('lost_reason' in data) || (data.lost_reason is string && data.lost_reason.size() <= 1000))
             && (!('lost_at' in data) || (data.lost_at is string && data.lost_at.size() <= 64) || data.lost_at is timestamp)
             && (!('reported_by' in data) || (data.reported_by is string && data.reported_by.size() <= 256))
             && (!('reported_by_account_uid' in data) || (data.reported_by_account_uid is string && data.reported_by_account_uid.size() <= 128))
             && (!('related_vehicle_log_id' in data) || (data.related_vehicle_log_id is string && data.related_vehicle_log_id.size() <= 128))
             && (!('replacement_card_id' in data) || (data.replacement_card_id is string && data.replacement_card_id.size() <= 128))
             && (!('replaced_by_card_id' in data) || (data.replaced_by_card_id is string && data.replaced_by_card_id.size() <= 128))
             && (!('replaced_by_document_id' in data) || (data.replaced_by_document_id is string && data.replaced_by_document_id.size() <= 128))
             && (!('replacement_for_card_id' in data) || (data.replacement_for_card_id is string && data.replacement_for_card_id.size() <= 128))
             && (!('replacement_for_document_id' in data) || (data.replacement_for_document_id is string && data.replacement_for_document_id.size() <= 128))
             && (!('replacement_reason' in data) || (data.replacement_reason is string && data.replacement_reason.size() <= 2000))
             && (!('replacement_at' in data) || (data.replacement_at is string && data.replacement_at.size() <= 64) || data.replacement_at is timestamp)
             && (!('replacement_by' in data) || (data.replacement_by is string && data.replacement_by.size() <= 128))
             && (!('created_by' in data) || (data.created_by is string && data.created_by.size() <= 128))
             && (!('replacement_approved' in data) || data.replacement_approved is bool)
             && (!('replacement_approved_by' in data) || (data.replacement_approved_by is string && data.replacement_approved_by.size() <= 128))
             && (!('replacement_approved_at' in data) || (data.replacement_approved_at is string && data.replacement_approved_at.size() <= 64))
             && (!('note' in data) || (data.note is string && data.note.size() <= 2000));
    }

    function allowedParkingCardTransition() {
      return request.resource.data.status == resource.data.status
             || (resource.data.status in ['Available', 'ว่าง'] && request.resource.data.status in ['InUse', 'Disabled', 'Suspended', 'Lost', 'VIP'])
             || (resource.data.status in ['Available', 'ว่าง'] && request.resource.data.status == 'Reserved')
             || (resource.data.status == 'Reserved' && request.resource.data.status in ['Available', 'InUse'])
             || (resource.data.status == 'Returned' && request.resource.data.status == 'Available')
             || (resource.data.status in ['InUse', 'ใช้งานอยู่', 'In Use'] && request.resource.data.status in ['Available', 'Lost'])
             || (resource.data.status == 'Suspended' && request.resource.data.status == 'Available')
             || (resource.data.status == 'Disabled' && request.resource.data.status in ['Available', 'Lost'])
             || (resource.data.status == 'Lost' && request.resource.data.status == 'ReplacementApproved')
             || (resource.data.status == 'ReplacementApproved' && request.resource.data.status == 'Retired')
             || (resource.data.status == 'VIP' && request.resource.data.status == 'Available');
    }

    // Update validation is intentionally delta-based. Re-running the full create
    // schema for every document in a multi-document vehicle transaction can exceed
    // Firestore's 1,000-expression request limit. Every update branch below also
    // has a strict affectedKeys() allowlist.
    function validParkingCardUpdateData() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return data.keys().hasOnly([
               'firestore_document_id', 'card_id', 'site_id', 'card_number', 'card_number_normalized', 'qr_code_value', 'qr_code_normalized', 'card_type', 'status', 'status_normalized', 'status_original',
               'current_vehicle_plate', 'current_vehicle_log_id', 'current_vehicle_session_id', 'last_activity_at', 'member_id', 'lost_reason', 'lost_at', 'reported_by', 'reported_by_account_uid', 'related_vehicle_log_id',
               'replacement_card_id', 'replaced_by_card_id', 'replaced_by_document_id', 'replacement_for_card_id', 'replacement_for_document_id', 'replacement_reason', 'replacement_at', 'replacement_by', 'created_by', 'replacement_approved', 'replacement_approved_by',
               'replacement_approved_at', 'note', 'created_at', 'updated_at'
             ])
             && (!changed.hasAny(['card_number']) || (data.card_number is string && data.card_number.size() > 0 && data.card_number.size() <= 64 && data.card_number.matches('^[A-Za-z0-9 /_-]+$')))
             && (!changed.hasAny(['card_number_normalized']) || (data.card_number_normalized is string && data.card_number_normalized.size() <= 64))
             && (!changed.hasAny(['qr_code_value']) || (data.qr_code_value is string && data.qr_code_value.size() <= 256))
             && (!changed.hasAny(['qr_code_normalized']) || (data.qr_code_normalized is string && data.qr_code_normalized.size() <= 256))
             && (!changed.hasAny(['card_type']) || data.card_type in ['Normal', 'Temporary', 'VIP', 'Resident', 'Contractor', 'Staff', 'Other'])
             && data.status in ['Available', 'Reserved', 'Returned', 'InUse', 'In Use', 'Disabled', 'Suspended', 'Lost', 'Cancelled', 'Replaced', 'ReplacementApproved', 'Retired', 'VIP', 'ว่าง', 'ใช้งานอยู่', 'กำลังใช้งาน', 'VehicleInside', 'ระงับ', 'บัตรหาย']
             && (!changed.hasAny(['status_normalized']) || data.status_normalized in ['Available', 'Reserved', 'Returned', 'InUse', 'Disabled', 'Suspended', 'Lost', 'Cancelled', 'Replaced', 'ReplacementApproved', 'Retired', 'VIP'])
             && (!changed.hasAny(['current_vehicle_plate']) || (data.current_vehicle_plate is string && data.current_vehicle_plate.size() <= 64))
             && (!changed.hasAny(['current_vehicle_log_id']) || (data.current_vehicle_log_id is string && data.current_vehicle_log_id.size() <= 128))
             && (!changed.hasAny(['current_vehicle_session_id']) || (data.current_vehicle_session_id is string && data.current_vehicle_session_id.size() <= 128))
             && (!changed.hasAny(['last_activity_at']) || data.last_activity_at is timestamp || (data.last_activity_at is string && data.last_activity_at.size() <= 64))
             && (!changed.hasAny(['updated_at']) || data.updated_at is timestamp || (data.updated_at is string && data.updated_at.size() <= 64))
             && (!changed.hasAny(['lost_reason']) || (data.lost_reason is string && data.lost_reason.size() <= 1000))
             && (!changed.hasAny(['lost_at']) || data.lost_at is timestamp || (data.lost_at is string && data.lost_at.size() <= 64))
             && (!changed.hasAny(['reported_by']) || (data.reported_by is string && data.reported_by.size() <= 256))
             && (!changed.hasAny(['reported_by_account_uid']) || (data.reported_by_account_uid is string && data.reported_by_account_uid.size() <= 128))
             && (!changed.hasAny(['related_vehicle_log_id']) || (data.related_vehicle_log_id is string && data.related_vehicle_log_id.size() <= 128))
             && (!changed.hasAny(['member_id']) || (data.member_id is string && data.member_id.size() <= 128))
             && (!changed.hasAny(['note']) || (data.note is string && data.note.size() <= 2000));
    }

    function validReplacementCreate(documentId) {
      return (!('replacement_for_document_id' in request.resource.data)
                && !('replacement_for_card_id' in request.resource.data))
             || (request.resource.data.replacement_for_document_id is string
                && existsAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.replacement_for_document_id))
                && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.replacement_for_document_id)).data.replaced_by_document_id == documentId
                && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.replacement_for_document_id)).data.replaced_by_card_id == request.resource.data.card_id);
    }

    function validReplacementUpdate(documentId) {
      return !('replaced_by_document_id' in request.resource.data)
             || (request.resource.data.replaced_by_document_id is string
                && existsAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.replaced_by_document_id))
                && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.replaced_by_document_id)).data.replacement_for_document_id == documentId
                && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.replaced_by_document_id)).data.replacement_for_card_id == request.resource.data.card_id);
    }

    function guardParkingCardTransition() {
      let activeLogId = ('current_vehicle_log_id' in resource.data && resource.data.current_vehicle_log_id != '')
        ? resource.data.current_vehicle_log_id
        : request.resource.data.related_vehicle_log_id;
      return isActiveUser()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'site_id', 'card_type', 'status', 'status_normalized', 'current_vehicle_plate', 'current_vehicle_log_id', 'last_activity_at', 'updated_at',
                  'lost_reason', 'lost_at', 'reported_by', 'reported_by_account_uid', 'related_vehicle_log_id'
                ])
             && (request.resource.data.site_id == resource.data.site_id
               || (isAdmin() && !('site_id' in resource.data) && request.resource.data.site_id == activeSiteId()))
             && (
               ((resource.data.status in ['Available', 'ว่าง'])
                 && request.resource.data.status == 'InUse'
                 && request.resource.data.current_vehicle_log_id is string
                 && existsAfter(/databases/$(database)/documents/vehicleLogs/$(request.resource.data.current_vehicle_log_id))
                 && getAfter(/databases/$(database)/documents/vehicleLogs/$(request.resource.data.current_vehicle_log_id)).data.card_number == request.resource.data.card_number
                 && getAfter(/databases/$(database)/documents/vehicleLogs/$(request.resource.data.current_vehicle_log_id)).data.status == 'กำลังจอด')
               || ((resource.data.status in ['InUse', 'In Use', 'ใช้งานอยู่'])
                 && canProcessVehicleExit()
                 && request.resource.data.status in ['Available', 'Lost']
                 && activeLogId is string
                 && activeLogId == request.resource.data.related_vehicle_log_id
                 && (('current_vehicle_log_id' in resource.data && resource.data.current_vehicle_log_id != '') || isAdmin())
                 && getAfter(/databases/$(database)/documents/vehicleLogs/$(activeLogId)).data.card_number == request.resource.data.card_number
                 && getAfter(/databases/$(database)/documents/vehicleLogs/$(activeLogId)).data.status == 'ออกแล้ว'
                 && (request.resource.data.status == 'Available'
                   || (request.resource.data.lost_reason is string
                     && request.resource.data.reported_by_account_uid == request.auth.uid
                     && request.resource.data.related_vehicle_log_id == activeLogId)))
             );
    }

    function vehicleSessionCardTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return canProcessVehicleExit()
             && request.resource.data.site_id == resource.data.site_id
             && request.resource.data.site_id == activeSiteId()
             && (
               (resource.data.status in ['Available', 'ว่าง']
                 && request.resource.data.status == 'Reserved'
                 && changed.hasOnly(['status', 'status_normalized', 'current_vehicle_session_id', 'last_activity_at', 'updated_at'])
                 && request.resource.data.current_vehicle_session_id is string
                 && existsAfter(/databases/$(database)/documents/vehicleSessions/$(request.resource.data.current_vehicle_session_id))
                 && getAfter(/databases/$(database)/documents/vehicleSessions/$(request.resource.data.current_vehicle_session_id)).data.parking_card_id == request.resource.data.firestore_document_id)
               || (resource.data.status == 'Reserved'
                 && request.resource.data.status == 'InUse'
                 && changed.hasOnly(['status', 'status_normalized', 'current_vehicle_plate', 'current_vehicle_log_id', 'current_vehicle_session_id', 'last_activity_at', 'updated_at'])
                 && resource.data.current_vehicle_session_id is string
                 && request.resource.data.current_vehicle_session_id == ''
                 && request.resource.data.current_vehicle_log_id is string
                 && existsAfter(/databases/$(database)/documents/vehicleLogs/$(request.resource.data.current_vehicle_log_id))
                 && getAfter(/databases/$(database)/documents/vehicleLogs/$(request.resource.data.current_vehicle_log_id)).data.card_number == request.resource.data.card_number)
               || (resource.data.status == 'Reserved'
                 && request.resource.data.status == 'Available'
                 && changed.hasOnly(['status', 'status_normalized', 'current_vehicle_session_id', 'last_activity_at', 'updated_at'])
                 && request.resource.data.current_vehicle_session_id == '')
             );
    }

    function validVehicleSession(data) {
      return data.keys().hasOnly([
               'session_id', 'site_id', 'parking_card_id', 'card_number', 'stage', 'status',
               'opened_by', 'opened_by_name', 'current_owner', 'last_updated_by', 'assigned_to',
               'queueStatus', 'priority', 'assignedTo', 'assignedBy', 'assignedAt', 'queuePosition',
               'queueSchemaVersion', 'queue_migrated_at', 'queue_migrated_by', 'assignmentVersion',
               'sessionVersion', 'queueMetrics',
               'last_activity_at', 'editing_by', 'editing_by_name', 'editing_since', 'expires_at',
               'vehicle_plate', 'vehicle_type', 'visitor_name', 'visitor_phone', 'target_room',
               'target_unit_id', 'target_building', 'unit_lookup_status', 'purpose', 'note',
               'entry_plate_photo_url', 'entry_vehicle_photo_url', 'vehicle_log_id',
               'activity', 'stage_updates', 'created_at', 'updated_at'
             ])
             && data.keys().hasAll([
               'session_id', 'site_id', 'parking_card_id', 'card_number', 'stage', 'status',
               'opened_by', 'current_owner', 'last_updated_by',
               'queueStatus', 'priority', 'assignedTo', 'assignedBy', 'queuePosition',
               'sessionVersion', 'queueMetrics',
               'last_activity_at', 'activity', 'created_at', 'updated_at'
             ])
             && data.session_id is string && data.session_id.size() <= 128
             && data.site_id == activeSiteId()
             && data.parking_card_id is string && data.parking_card_id.size() <= 128
             && data.card_number is string && data.card_number.size() <= 64
             && data.stage in ['Created', 'CardIssued', 'VehicleEntered', 'PlateCaptured', 'VehicleCaptured', 'VisitorInfo', 'DestinationSelected', 'EvidenceUploaded', 'Ready', 'Active', 'VehicleExited', 'Completed', 'Cancelled']
             && data.status in ['Draft', 'Pending', 'InProgress', 'WaitingPhoto', 'WaitingVisitor', 'WaitingDestination', 'WaitingEvidence', 'Ready', 'Completed', 'Cancelled']
             && data.opened_by is string
             && data.current_owner is string
             && data.last_updated_by is string
             && (!('assigned_to' in data) || data.assigned_to is string)
             && data.queueStatus in ['Waiting', 'Assigned', 'In Progress', 'Waiting Information', 'Ready', 'Completed']
             && data.priority in ['Emergency', 'High', 'Normal', 'Low']
             && (data.assignedTo is string || data.assignedTo == null)
             && (data.assignedBy is string || data.assignedBy == null)
             && (!('assignedAt' in data) || data.assignedAt is timestamp || data.assignedAt == null)
             && (data.queuePosition is int || data.queuePosition == null)
             && (!('queueSchemaVersion' in data) || data.queueSchemaVersion == 1)
             && (!('queue_migrated_at' in data) || data.queue_migrated_at is timestamp)
             && (!('queue_migrated_by' in data) || data.queue_migrated_by is string)
             && (!('assignmentVersion' in data) || data.assignmentVersion is int)
             && data.sessionVersion is int && data.sessionVersion >= 0
             && validQueueMetrics(data.queueMetrics)
             && data.activity is list
             && data.activity.size() <= 500
             && (!('stage_updates' in data) || data.stage_updates is map)
             && (!('opened_by_name' in data) || (data.opened_by_name is string && data.opened_by_name.size() <= 256))
             && (!('vehicle_plate' in data) || (data.vehicle_plate is string && data.vehicle_plate.size() <= 64))
             && (!('vehicle_type' in data) || (data.vehicle_type is string && data.vehicle_type.size() <= 64))
             && (!('visitor_name' in data) || (data.visitor_name is string && data.visitor_name.size() <= 256))
             && (!('visitor_phone' in data) || (data.visitor_phone is string && data.visitor_phone.size() <= 64))
             && (!('target_room' in data) || (data.target_room is string && data.target_room.size() <= 128))
             && (!('target_unit_id' in data) || (data.target_unit_id is string && data.target_unit_id.size() <= 128))
             && (!('target_building' in data) || (data.target_building is string && data.target_building.size() <= 128))
             && (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 1000))
             && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
             && (!('entry_plate_photo_url' in data) || (data.entry_plate_photo_url is string && data.entry_plate_photo_url.size() <= 4096))
             && (!('entry_vehicle_photo_url' in data) || (data.entry_vehicle_photo_url is string && data.entry_vehicle_photo_url.size() <= 4096))
             && (!('vehicle_log_id' in data) || (data.vehicle_log_id is string && data.vehicle_log_id.size() <= 128))
             && (!('editing_by' in data) || data.editing_by is string)
             && (!('editing_by_name' in data) || (data.editing_by_name is string && data.editing_by_name.size() <= 256))
             && (!('editing_since' in data) || data.editing_since is timestamp || data.editing_since == null)
             && (!('expires_at' in data) || data.expires_at is timestamp || data.expires_at == null)
             && data.last_activity_at is timestamp
             && data.created_at is timestamp
             && data.updated_at is timestamp;
    }

    function validQueueMetrics(metrics) {
      return metrics is map
             && metrics.keys().hasOnly([
               'firstQueuedAt', 'firstAssignedAt', 'workStartedAt', 'readyAt', 'completedAt',
               'waitingSeconds', 'workingSeconds', 'totalCycleSeconds',
               'transferCount', 'reassignCount', 'releaseCount', 'priorityChangeCount',
               'lastTransitionAt', 'lastEventId', 'metricsVersion'
             ])
             && metrics.keys().hasAll([
               'firstQueuedAt', 'firstAssignedAt', 'workStartedAt', 'readyAt', 'completedAt',
               'waitingSeconds', 'workingSeconds', 'totalCycleSeconds',
               'transferCount', 'reassignCount', 'releaseCount', 'priorityChangeCount',
               'lastTransitionAt', 'lastEventId', 'metricsVersion'
             ])
             && (metrics.firstQueuedAt is timestamp || metrics.firstQueuedAt == null)
             && (metrics.firstAssignedAt is timestamp || metrics.firstAssignedAt == null)
             && (metrics.workStartedAt is timestamp || metrics.workStartedAt == null)
             && (metrics.readyAt is timestamp || metrics.readyAt == null)
             && (metrics.completedAt is timestamp || metrics.completedAt == null)
             && (metrics.lastTransitionAt is timestamp || metrics.lastTransitionAt == null)
             && metrics.waitingSeconds is int && metrics.waitingSeconds >= 0 && metrics.waitingSeconds <= 31536000
             && metrics.workingSeconds is int && metrics.workingSeconds >= 0 && metrics.workingSeconds <= 31536000
             && metrics.totalCycleSeconds is int && metrics.totalCycleSeconds >= 0 && metrics.totalCycleSeconds <= 31536000
             && metrics.transferCount is int && metrics.transferCount >= 0 && metrics.transferCount <= 10000
             && metrics.reassignCount is int && metrics.reassignCount >= 0 && metrics.reassignCount <= 10000
             && metrics.releaseCount is int && metrics.releaseCount >= 0 && metrics.releaseCount <= 10000
             && metrics.priorityChangeCount is int && metrics.priorityChangeCount >= 0 && metrics.priorityChangeCount <= 10000
             && metrics.lastEventId is string && metrics.lastEventId.size() <= 128
             && metrics.metricsVersion is int && metrics.metricsVersion >= 1;
    }

    function validVehicleSessionUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
               'stage', 'status', 'current_owner', 'last_updated_by', 'assigned_to',
               'queueStatus', 'priority', 'assignedTo', 'assignedBy', 'assignedAt',
               'queuePosition', 'assignmentVersion', 'sessionVersion',
               'last_activity_at', 'editing_by', 'editing_by_name', 'editing_since',
               'expires_at', 'vehicle_plate', 'vehicle_type', 'visitor_name',
               'visitor_phone', 'target_room', 'target_unit_id', 'target_building',
               'unit_lookup_status', 'purpose', 'note', 'entry_plate_photo_url',
               'entry_vehicle_photo_url', 'vehicle_log_id', 'stage_updates', 'updated_at'
             ])
             && data.stage in ['Created', 'CardIssued', 'VehicleEntered', 'PlateCaptured', 'VehicleCaptured', 'VisitorInfo', 'DestinationSelected', 'EvidenceUploaded', 'Ready', 'Active', 'VehicleExited', 'Completed', 'Cancelled']
             && data.status in ['Draft', 'Pending', 'InProgress', 'WaitingPhoto', 'WaitingVisitor', 'WaitingDestination', 'WaitingEvidence', 'Ready', 'Completed', 'Cancelled']
             && data.queueStatus in ['Waiting', 'Assigned', 'In Progress', 'Waiting Information', 'Ready', 'Completed']
             && data.priority in ['Emergency', 'High', 'Normal', 'Low']
             && data.current_owner is string
             && data.last_updated_by is string
             && (data.assignedTo is string || data.assignedTo == null)
             && (data.assignedBy is string || data.assignedBy == null)
             && (!('assignedAt' in data) || data.assignedAt is timestamp || data.assignedAt == null)
             && (data.queuePosition is int || data.queuePosition == null)
             && data.assignmentVersion is int && data.assignmentVersion >= 0
             && data.sessionVersion is int && data.sessionVersion >= 0
             && data.last_activity_at is timestamp
             && data.updated_at is timestamp
             && (!changed.hasAny(['editing_by']) || data.editing_by is string)
             && (!changed.hasAny(['editing_by_name']) || (data.editing_by_name is string && data.editing_by_name.size() <= 256))
             && (!changed.hasAny(['editing_since']) || data.editing_since is timestamp || data.editing_since == null)
             && (!changed.hasAny(['expires_at']) || data.expires_at is timestamp || data.expires_at == null)
             && (!changed.hasAny(['vehicle_plate']) || (data.vehicle_plate is string && data.vehicle_plate.size() <= 64))
             && (!changed.hasAny(['vehicle_type']) || (data.vehicle_type is string && data.vehicle_type.size() <= 64))
             && (!changed.hasAny(['visitor_name']) || (data.visitor_name is string && data.visitor_name.size() <= 256))
             && (!changed.hasAny(['visitor_phone']) || (data.visitor_phone is string && data.visitor_phone.size() <= 64))
             && (!changed.hasAny(['target_room']) || (data.target_room is string && data.target_room.size() <= 128))
             && (!changed.hasAny(['target_unit_id']) || (data.target_unit_id is string && data.target_unit_id.size() <= 128))
             && (!changed.hasAny(['target_building']) || (data.target_building is string && data.target_building.size() <= 128))
             && (!changed.hasAny(['unit_lookup_status']) || data.unit_lookup_status in ['matched', 'manual'])
             && (!changed.hasAny(['purpose']) || (data.purpose is string && data.purpose.size() <= 1000))
             && (!changed.hasAny(['note']) || (data.note is string && data.note.size() <= 2000))
             && (!changed.hasAny(['entry_plate_photo_url']) || (data.entry_plate_photo_url is string && data.entry_plate_photo_url.size() <= 4096))
             && (!changed.hasAny(['entry_vehicle_photo_url']) || (data.entry_vehicle_photo_url is string && data.entry_vehicle_photo_url.size() <= 4096))
             && (!changed.hasAny(['vehicle_log_id']) || (data.vehicle_log_id is string && data.vehicle_log_id.size() <= 128))
             && (!changed.hasAny(['stage_updates']) || data.stage_updates is map);
    }

    function activeOperatorAtSite(uid, siteId) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return profile.status == 'Active'
             && profile.site_id == siteId
             && profile.role in ['Guard', 'ShiftHead', 'Manager', 'Admin'];
    }

    function canUpdateVehicleSession() {
      let profile = ownProfile();
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let assignmentOrPriorityChanged = changed.hasAny([
        'assignedTo', 'assigned_to', 'assignedBy', 'assignedAt',
        'assignmentVersion', 'priority', 'queuePosition'
      ]);
      return signedIn()
             && profile.status == 'Active'
             && resource.data.site_id == profile.site_id
             && request.resource.data.site_id == profile.site_id
             && profile.role in ['Guard', 'ShiftHead', 'Manager', 'Admin']
             && validVehicleSessionTransition()
             && validAssignmentIdentityMutation()
             && validCurrentOwnerMutation()
             && validEditLockMutation()
             && (!assignmentOrPriorityChanged
               || profile.role in ['ShiftHead', 'Manager', 'Admin']
               || (profile.role == 'Guard' && validGuardQueueUpdate()));
    }

    function validAssignmentIdentityMutation() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let assignmentIdentityChanged = changed.hasAny([
        'assignedTo', 'assigned_to', 'assignedBy', 'assignedAt'
      ]);
      return !assignmentIdentityChanged
             || (data.assignedBy == request.auth.uid
               && ((data.assignedTo in ['', null] && data.assigned_to == '')
                 || (data.assignedTo is string && data.assignedTo != ''
                   && data.assigned_to == data.assignedTo)));
    }

    function validCurrentOwnerMutation() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let assignmentChanged = changed.hasAny(['assignedTo', 'assigned_to']);
      let workflowChanged = changed.hasAny(['stage', 'status']);
      return !changed.hasAny(['current_owner'])
             || (assignmentChanged
               && ((data.assignedTo in ['', null] && data.current_owner == '')
                 || (data.assignedTo is string && data.assignedTo != ''
                   && data.current_owner == data.assignedTo)))
             || (workflowChanged && data.current_owner == request.auth.uid);
    }

    function validEditLockMutation() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let lockChanged = changed.hasAny([
        'editing_by', 'editing_by_name', 'editing_since', 'expires_at'
      ]);
      let lockAcquired = data.editing_by == request.auth.uid
        && data.editing_by_name == ownProfile().operator_name
        && data.editing_since == request.time
        && data.expires_at is timestamp
        && data.expires_at > request.time
        && data.expires_at <= request.time + duration.value(1, 'h');
      let lockReleased = (!('editing_by' in resource.data)
          || resource.data.editing_by in ['', request.auth.uid])
        && data.editing_by == ''
        && data.editing_by_name == ''
        && data.editing_since == null
        && data.expires_at == null;
      return !lockChanged || lockAcquired || lockReleased;
    }

    function validVehicleSessionTransition() {
      let beforeStage = resource.data.stage;
      let afterStage = request.resource.data.stage;
      let beforeStatus = resource.data.status;
      let afterStatus = request.resource.data.status;
      let privilegedCancellation = ownProfile().role in ['ShiftHead', 'Manager', 'Admin'];
      return (beforeStage == afterStage && beforeStatus == afterStatus)
             || (beforeStage == 'Created' && afterStage == 'CardIssued'
               && beforeStatus in ['Draft', 'Pending'] && afterStatus == 'Pending')
             || (beforeStage == 'CardIssued'
               && afterStage in ['VehicleEntered', 'PlateCaptured', 'VehicleCaptured', 'VisitorInfo', 'DestinationSelected', 'EvidenceUploaded', 'Ready']
               && beforeStatus == 'Pending'
               && afterStatus in ['InProgress', 'WaitingPhoto', 'WaitingVisitor', 'WaitingDestination', 'WaitingEvidence', 'Ready'])
             || (beforeStage in ['VehicleEntered', 'PlateCaptured', 'VehicleCaptured', 'VisitorInfo', 'DestinationSelected', 'EvidenceUploaded']
               && afterStage in ['VehicleEntered', 'PlateCaptured', 'VehicleCaptured', 'VisitorInfo', 'DestinationSelected', 'EvidenceUploaded', 'Ready']
               && afterStatus in ['InProgress', 'WaitingPhoto', 'WaitingVisitor', 'WaitingDestination', 'WaitingEvidence', 'Ready'])
             || (beforeStage == 'Ready' && afterStage == 'Active'
               && beforeStatus == 'Ready' && afterStatus == 'InProgress')
             || (beforeStage == 'Active' && afterStage in ['VehicleExited', 'Completed']
               && beforeStatus == 'InProgress' && afterStatus == 'Completed')
             || (beforeStage == 'VehicleExited' && afterStage == 'Completed'
               && afterStatus == 'Completed')
             || (privilegedCancellation
               && !(beforeStage in ['Active', 'VehicleExited', 'Completed', 'Cancelled'])
               && afterStage == 'Cancelled' && afterStatus == 'Cancelled');
    }

    function validGuardQueueUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.priority == resource.data.priority
             && request.resource.data.queuePosition == resource.data.queuePosition
             && (
               (resource.data.assignedTo == request.auth.uid
                 && request.resource.data.assignedTo == request.auth.uid
                 && request.resource.data.assignedBy == resource.data.assignedBy
                 && request.resource.data.assignedAt == resource.data.assignedAt
                 && request.resource.data.assignmentVersion == resource.data.assignmentVersion)
               || (resource.data.assignedTo in ['', null]
                 && request.resource.data.assignedTo == request.auth.uid
                 && request.resource.data.assignedBy == request.auth.uid
                 && request.resource.data.assignmentVersion == resource.data.assignmentVersion + 1
                 && changed.hasOnly(['assignedTo', 'assigned_to', 'assignedBy', 'assignedAt', 'queueStatus', 'current_owner', 'last_updated_by', 'last_activity_at', 'updated_at', 'assignmentVersion', 'sessionVersion', 'queueMetrics']))
               || (resource.data.assignedTo == request.auth.uid
                 && request.resource.data.assignedTo in ['', null]
                 && request.resource.data.assignedBy == request.auth.uid
                 && request.resource.data.assignmentVersion == resource.data.assignmentVersion + 1
                 && changed.hasOnly(['assignedTo', 'assigned_to', 'assignedBy', 'assignedAt', 'queueStatus', 'current_owner', 'last_updated_by', 'last_activity_at', 'updated_at', 'assignmentVersion', 'sessionVersion', 'queueMetrics']))
             );
    }

    function validAssignmentVersion() {
      let assignmentChanged = request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['assignedTo', 'assignedBy', 'assignedAt']);
      return (assignmentChanged && request.resource.data.assignmentVersion == resource.data.assignmentVersion + 1)
             || (!assignmentChanged && request.resource.data.assignmentVersion == resource.data.assignmentVersion);
    }

    function validSessionActivity(data, sessionId, activityId) {
      return data.keys().hasOnly([
               'activity_id', 'session_id', 'action', 'from_stage', 'to_stage',
               'from_status', 'to_status', 'actor_uid', 'actor_operator_id',
               'actor_name', 'actor_role', 'site_id', 'details', 'created_at',
               'client_event_id', 'schema_version', 'vehicle_session_id',
               'vehicle_log_id', 'activity_type', 'title', 'description',
               'location', 'severity', 'status', 'photo_urls', 'updated_at'
             ])
             && data.keys().hasAll([
               'activity_id', 'session_id', 'action', 'actor_uid', 'actor_operator_id',
               'actor_name', 'actor_role', 'site_id', 'details', 'created_at',
               'client_event_id', 'schema_version'
             ])
             && data.activity_id == activityId
             && data.client_event_id == activityId
             && data.session_id == sessionId
             && data.actor_uid == request.auth.uid
             && data.actor_operator_id == request.auth.uid
             && data.actor_role == ownProfile().role
             && data.actor_name == ownProfile().operator_name
             && data.site_id == activeSiteId()
             && data.action is string && data.action.size() > 0 && data.action.size() <= 100
             && data.from_stage in ['', 'Created', 'CardIssued', 'VehicleEntered', 'PlateCaptured', 'VehicleCaptured', 'VisitorInfo', 'DestinationSelected', 'EvidenceUploaded', 'Ready', 'Active', 'VehicleExited', 'Completed', 'Cancelled']
             && data.to_stage in ['', 'Created', 'CardIssued', 'VehicleEntered', 'PlateCaptured', 'VehicleCaptured', 'VisitorInfo', 'DestinationSelected', 'EvidenceUploaded', 'Ready', 'Active', 'VehicleExited', 'Completed', 'Cancelled']
             && data.from_status in ['', 'Draft', 'Pending', 'InProgress', 'WaitingPhoto', 'WaitingVisitor', 'WaitingDestination', 'WaitingEvidence', 'Ready', 'Completed', 'Cancelled']
             && data.to_status in ['', 'Draft', 'Pending', 'InProgress', 'WaitingPhoto', 'WaitingVisitor', 'WaitingDestination', 'WaitingEvidence', 'Ready', 'Completed', 'Cancelled']
             && data.actor_name is string && data.actor_name.size() > 0 && data.actor_name.size() <= 150
             && data.client_event_id is string && data.client_event_id.size() > 0 && data.client_event_id.size() <= 128
             && data.schema_version == 1
             && data.created_at == request.time
             && data.details is map
             && data.details.keys().hasOnly(['note', 'reason', 'previous_assignee', 'new_assignee', 'priority', 'queue_status', 'vehicle_log_id'])
             && (!('note' in data.details) || (data.details.note is string && data.details.note.size() <= 500))
             && (!('reason' in data.details) || (data.details.reason is string && data.details.reason.size() <= 500))
             && (!('previous_assignee' in data.details) || (data.details.previous_assignee is string && data.details.previous_assignee.size() <= 128))
             && (!('new_assignee' in data.details) || (data.details.new_assignee is string && data.details.new_assignee.size() <= 128))
             && (!('priority' in data.details) || data.details.priority in ['Emergency', 'High', 'Normal', 'Low'])
             && (!('queue_status' in data.details) || data.details.queue_status in ['Waiting', 'Assigned', 'In Progress', 'Waiting Information', 'Ready', 'Completed'])
             && (!('vehicle_log_id' in data.details) || (data.details.vehicle_log_id is string && data.details.vehicle_log_id.size() <= 128))
             && validOperationalActivityFields(data, sessionId);
    }

    function validOperationalActivityFields(data, sessionId) {
      let operational = 'activity_type' in data;
      return !operational || (
        data.vehicle_session_id == sessionId
        && data.vehicle_log_id is string && data.vehicle_log_id.size() <= 128
        && data.activity_type in [
          'ParkingIssue', 'WrongParking', 'Obstruction', 'Accident', 'Damage',
          'Evidence', 'Remark', 'Warning', 'Violation', 'ContactResident',
          'ContactVehicleOwner', 'VehicleMoved', 'FollowUp', 'Custom'
        ]
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.description is string && data.description.size() <= 2000
        && data.location is string && data.location.size() <= 256
        && data.severity in ['Low', 'Normal', 'High', 'Critical']
        && data.status in ['Open', 'Monitoring', 'Resolved', 'Recorded']
        && data.photo_urls is list && data.photo_urls.size() <= 5
        && (data.photo_urls.size() < 1 || (data.photo_urls[0] is string && data.photo_urls[0].size() <= 4096))
        && (data.photo_urls.size() < 2 || (data.photo_urls[1] is string && data.photo_urls[1].size() <= 4096))
        && (data.photo_urls.size() < 3 || (data.photo_urls[2] is string && data.photo_urls[2].size() <= 4096))
        && (data.photo_urls.size() < 4 || (data.photo_urls[3] is string && data.photo_urls[3].size() <= 4096))
        && (data.photo_urls.size() < 5 || (data.photo_urls[4] is string && data.photo_urls[4].size() <= 4096))
        && data.updated_at == request.time
      );
    }

    function adminQueueMigration() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
             && resource.data.site_id == activeSiteId()
             && request.resource.data.site_id == resource.data.site_id
             && request.resource.data.session_id == resource.data.session_id
             && request.resource.data.parking_card_id == resource.data.parking_card_id
             && request.resource.data.created_at == resource.data.created_at
             && request.resource.data.queueSchemaVersion == 1
             && request.resource.data.queue_migrated_by == request.auth.uid
             && request.resource.data.queue_migrated_at == request.time
             && changed.hasOnly([
               'queueStatus', 'priority', 'assignedTo', 'assignedBy', 'assignedAt',
               'queuePosition', 'queueSchemaVersion', 'queue_migrated_at', 'queue_migrated_by',
               'assignmentVersion', 'sessionVersion', 'queueMetrics'
             ])
             && validVehicleSession(request.resource.data);
    }

    function adminParkingCardTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return canManageParkingCards() && (
        (request.resource.data.status == resource.data.status
          && ((resource.data.status == 'InUse' && changed.hasOnly(['card_type', 'note', 'updated_at']))
            || (resource.data.status != 'InUse' && changed.hasOnly(['card_number', 'card_number_normalized', 'qr_code_value', 'qr_code_normalized', 'card_type', 'note', 'updated_at']))))
        || (resource.data.status == 'Available' && request.resource.data.status == 'Suspended'
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'last_activity_at', 'updated_at']))
        || (resource.data.status == 'Available' && request.resource.data.status == 'Disabled'
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'last_activity_at', 'updated_at']))
        || (resource.data.status == 'Disabled' && request.resource.data.status == 'Available'
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'current_vehicle_plate', 'last_activity_at', 'updated_at']))
        || (resource.data.status == 'Suspended' && request.resource.data.status == 'Available'
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'current_vehicle_plate', 'last_activity_at', 'updated_at']))
        || (resource.data.status in ['Available', 'Disabled'] && request.resource.data.status == 'Lost'
          && request.resource.data.reported_by_account_uid == request.auth.uid
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'lost_reason', 'lost_at', 'reported_by', 'reported_by_account_uid', 'replaced_by_card_id', 'replaced_by_document_id', 'replacement_card_id', 'replacement_reason', 'replacement_at', 'replacement_by', 'last_activity_at', 'updated_at']))
        || (resource.data.status in ['Lost', 'Cancelled'] && request.resource.data.status == resource.data.status
          && request.resource.data.replacement_by == request.auth.uid
          && changed.hasOnly(['replaced_by_card_id', 'replaced_by_document_id', 'replacement_card_id', 'replacement_reason', 'replacement_at', 'replacement_by', 'updated_at']))
        || (resource.data.status == 'Lost' && request.resource.data.status == 'ReplacementApproved'
          && changed.hasOnly(['status', 'status_normalized', 'replacement_card_id', 'replacement_approved', 'replacement_approved_by', 'replacement_approved_at', 'updated_at']))
        || (resource.data.status == 'ReplacementApproved' && request.resource.data.status == 'Retired'
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'last_activity_at', 'updated_at']))
        || (resource.data.status == 'Available' && request.resource.data.status == 'VIP'
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'member_id', 'last_activity_at', 'updated_at']))
        || (resource.data.status == 'VIP' && request.resource.data.status == 'Available'
          && changed.hasOnly(['card_type', 'status', 'status_normalized', 'member_id', 'last_activity_at', 'updated_at']))
      );
    }

    function adminParkingCardMigration(documentId) {
      return isAdmin()
             && (!('site_id' in resource.data) || resource.data.site_id == activeSiteId())
             && request.resource.data.site_id == activeSiteId()
             && request.resource.data.card_id == resource.data.card_id
             && request.resource.data.status == resource.data.status
             && request.resource.data.firestore_document_id == documentId
             && request.resource.data.card_type in ['Temporary', 'VIP', 'Resident', 'Contractor', 'Staff', 'Other']
             && (!('firestore_document_id' in resource.data) || request.resource.data.firestore_document_id == resource.data.firestore_document_id)
             && (!('card_type' in resource.data)
               || request.resource.data.card_type == resource.data.card_type
               || !(resource.data.card_type in ['Normal', 'Temporary', 'VIP', 'Resident', 'Contractor', 'Staff', 'Other'])
               || (resource.data.card_type == 'Normal' && request.resource.data.card_type == 'Temporary'))
             && request.resource.data.card_number_normalized is string && request.resource.data.card_number_normalized.size() <= 64
             && request.resource.data.qr_code_normalized is string && request.resource.data.qr_code_normalized.size() <= 256
             && (('qr_code_value' in resource.data && request.resource.data.qr_code_value == resource.data.qr_code_value)
               || (!('qr_code_value' in resource.data) && request.resource.data.qr_code_value == request.resource.data.card_number))
             && request.resource.data.status_normalized in ['Available', 'InUse', 'Disabled', 'Suspended', 'Lost', 'Cancelled', 'Replaced', 'ReplacementApproved', 'Retired', 'VIP']
             && request.resource.data.updated_at is string && request.resource.data.updated_at.size() <= 64
             && (!('created_at' in resource.data) || request.resource.data.created_at == resource.data.created_at)
             && (!('current_vehicle_plate' in resource.data) || request.resource.data.current_vehicle_plate == resource.data.current_vehicle_plate)
             && (!('current_vehicle_log_id' in resource.data) || request.resource.data.current_vehicle_log_id == resource.data.current_vehicle_log_id)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'firestore_document_id', 'site_id', 'card_type', 'card_number_normalized', 'qr_code_value', 'qr_code_normalized', 'status_normalized', 'created_at', 'updated_at'
                ]);
    }

    function validVehicleLog(data) {
      return data.keys().hasOnly([
               'log_id', 'vehicle_session_id', 'site_id', 'card_number', 'parking_card_id', 'vehicle_plate', 'vehicle_type', 'visitor_name',
               'visitor_phone', 'target_room', 'target_unit_id', 'target_building', 'unit_lookup_status',
               'purpose', 'entry_time', 'exit_time', 'entry_plate_photo_url',
               'entry_vehicle_photo_url', 'exit_plate_photo_url', 'exit_vehicle_photo_url',
               'workflow_status', 'exit_recorded_by', 'exit_account_uid', 'exit_operator_id', 'exit_operator_name', 'exit_role', 'exit_site_id', 'exit_note', 'abnormal_note',
               'status', 'recorded_by', 'note', 'created_at', 'updated_at',
               'login_email', 'operator_name', 'operator_id', 'account_uid'
             ])
             && data.keys().hasAll([
               'log_id', 'site_id', 'card_number', 'parking_card_id', 'vehicle_plate', 'vehicle_type', 'visitor_name',
               'visitor_phone', 'target_room', 'purpose', 'entry_time', 'status',
               'recorded_by', 'created_at', 'updated_at'
             ])
             && data.log_id is string
             && data.log_id.size() > 0 && data.log_id.size() <= 128
             && (!('vehicle_session_id' in data) || (data.vehicle_session_id is string && data.vehicle_session_id.size() <= 128))
             && data.site_id is string && data.site_id.size() > 0 && data.site_id.size() <= 64
             && data.card_number is string && data.card_number.size() > 0 && data.card_number.size() <= 64
             && data.parking_card_id is string && data.parking_card_id.size() > 0 && data.parking_card_id.size() <= 128
             && data.vehicle_plate is string && data.vehicle_plate.size() > 0 && data.vehicle_plate.size() <= 64
             && data.vehicle_type is string && data.vehicle_type.size() <= 64
             && data.visitor_name is string && data.visitor_name.size() <= 256
             && data.visitor_phone is string && data.visitor_phone.size() <= 64
             && data.target_room is string && data.target_room.size() <= 128
             && (!('target_unit_id' in data) || (data.target_unit_id is string && data.target_unit_id.size() <= 128))
             && (!('target_building' in data) || (data.target_building is string && data.target_building.size() <= 128))
             && data.purpose is string && data.purpose.size() <= 1000
             && data.recorded_by is string && data.recorded_by.size() <= 256
             && data.status in ['กำลังจอด', 'ออกแล้ว']
             && data.entry_time is string && data.entry_time.size() <= 64
             && data.created_at is string && data.created_at.size() <= 64
             && ((data.updated_at is string && data.updated_at.size() <= 64) || data.updated_at is timestamp)
             && (!('exit_time' in data) || (data.exit_time is string && data.exit_time.size() <= 64) || data.exit_time is timestamp)
             && (!('workflow_status' in data) || data.workflow_status in ['active', 'completed'])
             && (!('exit_recorded_by' in data) || data.exit_recorded_by is string)
             && (!('exit_account_uid' in data) || data.exit_account_uid is string)
             && (!('exit_operator_id' in data) || data.exit_operator_id is string)
             && (!('exit_operator_name' in data) || data.exit_operator_name is string)
             && (!('exit_role' in data) || data.exit_role in ['Guard', 'ShiftHead', 'Manager', 'Admin'])
             && (!('exit_site_id' in data) || data.exit_site_id is string)
             && (!('exit_note' in data) || (data.exit_note is string && data.exit_note.size() <= 2000))
             && (!('abnormal_note' in data) || (data.abnormal_note is string && data.abnormal_note.size() <= 2000))
             && (!('note' in data) || (data.note is string && data.note.size() <= 2000));
    }

    function validVehicleExitTransition() {
      return canProcessVehicleExit()
             && resource.data.status == 'กำลังจอด'
             && request.resource.data.status == 'ออกแล้ว'
             && request.resource.data.log_id == resource.data.log_id
             && request.resource.data.card_number == resource.data.card_number
             && request.resource.data.vehicle_plate == resource.data.vehicle_plate
             && request.resource.data.entry_time == resource.data.entry_time
             && (request.resource.data.site_id == resource.data.site_id
               || (isAdmin() && !('site_id' in resource.data) && request.resource.data.site_id == activeSiteId()))
             && request.resource.data.parking_card_id is string
             && request.resource.data.account_uid == resource.data.account_uid
             && request.resource.data.operator_id == resource.data.operator_id
             && request.resource.data.exit_account_uid == request.auth.uid
             && request.resource.data.exit_operator_id == request.auth.uid
             && request.resource.data.exit_role == ownProfile().role
             && request.resource.data.exit_site_id == activeSiteId()
             && request.resource.data.workflow_status == 'completed'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'parking_card_id', 'site_id', 'exit_time', 'exit_plate_photo_url', 'exit_vehicle_photo_url', 'status', 'workflow_status', 'updated_at',
                  'exit_recorded_by', 'exit_account_uid', 'exit_operator_id', 'exit_operator_name', 'exit_role', 'exit_site_id', 'exit_note', 'abnormal_note'
                ])
             && request.resource.data.exit_time is timestamp
             && request.resource.data.updated_at is timestamp
             && request.resource.data.exit_recorded_by is string
             && request.resource.data.exit_operator_name is string
             && request.resource.data.exit_note is string && request.resource.data.exit_note.size() <= 2000
             && request.resource.data.abnormal_note is string && request.resource.data.abnormal_note.size() <= 2000
             && request.resource.data.exit_plate_photo_url is string && request.resource.data.exit_plate_photo_url.size() <= 4096
             && request.resource.data.exit_vehicle_photo_url is string && request.resource.data.exit_vehicle_photo_url.size() <= 4096;
    }

    function validActiveVehicleLogDetailUpdate(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return canProcessVehicleExit()
             && resource.data.site_id == activeSiteId()
             && request.resource.data.site_id == resource.data.site_id
             && resource.data.status == 'กำลังจอด'
             && request.resource.data.status == resource.data.status
             && resource.data.workflow_status == 'active'
             && request.resource.data.workflow_status == resource.data.workflow_status
             && request.resource.data.log_id == id
             && request.resource.data.log_id == resource.data.log_id
             && request.resource.data.vehicle_session_id == resource.data.vehicle_session_id
             && request.resource.data.parking_card_id == resource.data.parking_card_id
             && request.resource.data.card_number == resource.data.card_number
             && request.resource.data.entry_time == resource.data.entry_time
             && request.resource.data.created_at == resource.data.created_at
             && request.resource.data.account_uid == resource.data.account_uid
             && request.resource.data.operator_id == resource.data.operator_id
             && changed.hasOnly([
               'vehicle_plate', 'vehicle_type', 'visitor_name', 'visitor_phone',
               'target_room', 'target_unit_id', 'target_building', 'unit_lookup_status',
               'purpose', 'note', 'entry_plate_photo_url', 'entry_vehicle_photo_url',
               'updated_at'
             ])
             && getAfter(/databases/$(database)/documents/vehicleSessions/$(resource.data.vehicle_session_id)).data.site_id == activeSiteId()
             && getAfter(/databases/$(database)/documents/vehicleSessions/$(resource.data.vehicle_session_id)).data.stage == 'Active'
             && getAfter(/databases/$(database)/documents/vehicleSessions/$(resource.data.vehicle_session_id)).data.status == 'InProgress'
             && getAfter(/databases/$(database)/documents/vehicleSessions/$(resource.data.vehicle_session_id)).data.vehicle_log_id == id
             && getAfter(/databases/$(database)/documents/vehicleSessions/$(resource.data.vehicle_session_id)).data.vehicle_plate == request.resource.data.vehicle_plate
             && getAfter(/databases/$(database)/documents/vehicleSessions/$(resource.data.vehicle_session_id)).data.target_room == request.resource.data.target_room;
    }

    function validParkingAudit(data) {
      return data.keys().hasAll(['audit_id', 'operator_id', 'account_uid', 'site_id', 'card_number', 'vehicle_log_id', 'action', 'previous_state', 'new_state', 'timestamp'])
             && data.audit_id is string && data.audit_id.size() <= 128
             && data.operator_id == request.auth.uid
             && data.account_uid == request.auth.uid
             && data.site_id == activeSiteId()
             && data.card_number is string && data.card_number.size() <= 64
             && data.vehicle_log_id is string && data.vehicle_log_id.size() <= 128
             && data.action is string && data.action.size() <= 128
             && data.previous_state is string && data.previous_state.size() <= 64
             && data.new_state is string && data.new_state.size() <= 64
             && data.timestamp is timestamp
             && (!('reason' in data) || (data.reason is string && data.reason.size() <= 2000));
    }

    function validParkingCardHistory(data) {
      return data.keys().hasOnly([
               'history_id', 'event_type', 'parking_card_id', 'card_number', 'site_id',
               'vehicle_log_id', 'replacement_card_id', 'operator_id', 'operator_name',
               'previous_state', 'new_state', 'reason', 'action_result', 'occurred_at', 'created_at'
             ])
             && data.keys().hasAll([
               'history_id', 'event_type', 'parking_card_id', 'card_number', 'site_id',
               'vehicle_log_id', 'operator_id', 'operator_name', 'previous_state',
               'new_state', 'reason', 'action_result', 'occurred_at', 'created_at'
             ])
             && data.history_id is string && data.history_id.size() > 0 && data.history_id.size() <= 128
             && data.event_type in [
               'CARD_CREATED', 'CARD_UPDATED', 'CARD_SCANNED', 'ENTRY', 'EXIT',
               'STATUS_CHANGED', 'LOST', 'REPLACEMENT_CREATED', 'VIP_SCAN', 'DELETED'
             ]
             && data.parking_card_id is string && data.parking_card_id.size() > 0 && data.parking_card_id.size() <= 128
             && data.card_number is string && data.card_number.size() <= 64
             && data.site_id is string && data.site_id == activeSiteId()
             && data.vehicle_log_id is string && data.vehicle_log_id.size() <= 128
             && (!('replacement_card_id' in data) || (data.replacement_card_id is string && data.replacement_card_id.size() <= 128))
             && data.operator_id == request.auth.uid
             && data.operator_name is string && data.operator_name.size() <= 256
             && data.previous_state is string && data.previous_state.size() <= 64
             && data.new_state is string && data.new_state.size() <= 64
             && data.reason is string && data.reason.size() <= 2000
             && data.action_result is string && data.action_result.size() <= 64
             && data.occurred_at is timestamp
             && data.created_at is timestamp;
    }

    function validUnit(data) {
      return data.keys().hasOnly([
               'firestore_document_id', 'unit_id', 'site_id', 'building', 'room_code', 'room_number', 'floor', 'area', 'ratio',
               'owner_name', 'resident_name', 'phone', 'email', 'occupancy_status', 'status',
               'searchable_text', 'search_key', 'is_active', 'created_at', 'updated_at',
               'source_file_name', 'import_batch_id'
             ])
             && data.keys().hasAll(['unit_id', 'site_id', 'building', 'room_number', 'floor', 'owner_name', 'resident_name', 'status', 'is_active', 'created_at', 'updated_at'])
             && data.unit_id is string && data.unit_id.size() > 0 && data.unit_id.size() <= 128
             && (!('firestore_document_id' in data) || (data.firestore_document_id is string && data.firestore_document_id.size() > 0 && data.firestore_document_id.size() <= 128))
             && data.site_id is string && data.site_id.size() > 0 && data.site_id.size() <= 64
             && data.building is string && data.building.size() > 0 && data.building.size() <= 128
             && data.room_number is string && data.room_number.size() > 0 && data.room_number.size() <= 128
             && data.floor is string && data.floor.size() > 0 && data.floor.size() <= 64
             && data.owner_name is string && data.owner_name.size() <= 256
             && data.resident_name is string && data.resident_name.size() <= 256
             && data.status in ['Active', 'Inactive']
             && data.is_active == (data.status == 'Active')
             && data.created_at is string && data.created_at.size() <= 64
             && data.updated_at is string && data.updated_at.size() <= 64
             && (!('room_code' in data) || (data.room_code is string && data.room_code.size() <= 128))
             && (!('area' in data) || (data.area is string && data.area.size() <= 64))
             && (!('ratio' in data) || (data.ratio is string && data.ratio.size() <= 64))
             && (!('phone' in data) || (data.phone is string && data.phone.size() <= 64))
             && (!('email' in data) || (data.email is string && data.email.size() <= 256))
             && (!('occupancy_status' in data) || (data.occupancy_status is string && data.occupancy_status.size() <= 64))
             && (!('searchable_text' in data) || (data.searchable_text is string && data.searchable_text.size() <= 2000))
             && (!('search_key' in data) || (data.search_key is string && data.search_key.size() <= 256))
             && (!('source_file_name' in data) || (data.source_file_name is string && data.source_file_name.size() <= 256))
             && (!('import_batch_id' in data) || (data.import_batch_id is string && data.import_batch_id.size() <= 512));
    }

    function validUnitAudit(data) {
      return data.keys().hasAll(['audit_id', 'operator_id', 'account_uid', 'site_id', 'action', 'module_name', 'record_id', 'old_value', 'new_value', 'created_at', 'action_result'])
             && data.operator_id == request.auth.uid
             && data.account_uid == request.auth.uid
             && data.site_id == activeSiteId()
             && data.module_name == 'units'
             && data.audit_id is string && data.audit_id.size() <= 128
             && data.action is string && data.action.size() <= 128
             && data.record_id is string && data.record_id.size() <= 256
             && data.old_value is string && data.old_value.size() <= 20000
             && data.new_value is string && data.new_value.size() <= 20000
             && data.action_result is string && data.action_result.size() <= 64
             && data.created_at == request.time;
    }

    function validKeyLogCreate(data, id) {
      return data.keys().hasOnly([
               'key_log_id', 'site_id', 'room_number', 'target_unit_id', 'unit_lookup_status',
               'key_type', 'borrower_name', 'borrower_phone', 'borrower_id_number',
               'purpose', 'checkout_time', 'issued_by', 'signature_image_url',
               'borrower_photo_url', 'document_photo_url', 'status', 'note',
               'created_at', 'updated_at'
             ])
             && data.keys().hasAll([
               'key_log_id', 'site_id', 'room_number', 'key_type', 'borrower_name',
               'borrower_phone', 'borrower_id_number', 'purpose', 'checkout_time',
               'issued_by', 'signature_image_url', 'borrower_photo_url', 'status',
               'created_at', 'updated_at'
             ])
             && data.key_log_id == id
             && data.site_id == activeSiteId()
             && data.room_number is string && data.room_number.size() > 0 && data.room_number.size() <= 128
             && data.key_type in ['ห้องพัก', 'ห้องไฟฟ้า', 'ห้องเครื่องจักร', 'พื้นที่ส่วนกลาง', 'อื่นๆ']
             && data.borrower_name is string && data.borrower_name.size() > 0 && data.borrower_name.size() <= 256
             && data.borrower_phone is string && data.borrower_phone.size() <= 64
             && data.borrower_id_number is string && data.borrower_id_number.size() <= 64
             && data.purpose is string && data.purpose.size() > 0 && data.purpose.size() <= 1000
             && data.issued_by is string && data.issued_by.size() > 0 && data.issued_by.size() <= 256
             && data.signature_image_url is string && data.signature_image_url.size() <= 4096
             && data.borrower_photo_url is string && data.borrower_photo_url.size() <= 4096
             && data.status == 'ถูกเบิก'
             && data.checkout_time == request.time
             && data.created_at == request.time
             && data.updated_at == request.time
             && (!('target_unit_id' in data) || data.target_unit_id is string)
             && (!('unit_lookup_status' in data) || data.unit_lookup_status in ['matched', 'manual'])
             && (!('document_photo_url' in data) || data.document_photo_url is string)
             && (!('note' in data) || (data.note is string && data.note.size() <= 2000));
    }

    function validKeyReturn() {
      return resource.data.site_id == activeSiteId()
             && resource.data.status == 'ถูกเบิก'
             && !('return_time' in resource.data)
             && request.resource.data.status == 'คืนแล้ว'
             && request.resource.data.return_time == request.time
             && request.resource.data.updated_at == request.time
             && request.resource.data.returned_by is string
             && request.resource.data.returned_by.size() > 0
             && request.resource.data.returned_by.size() <= 256
             && request.resource.data.return_photo_url is string
             && request.resource.data.return_photo_url.size() > 0
             && request.resource.data.return_photo_url.size() <= 4096
             && request.resource.data.return_photo_url.matches('^https://drive[.]google[.]com/.*')
             && request.resource.data.return_signature_url is string
             && request.resource.data.return_signature_url.size() > 0
             && request.resource.data.return_signature_url.size() <= 4096
             && request.resource.data.return_signature_url.matches('^https://drive[.]google[.]com/.*')
             && request.resource.data.return_photo_url != request.resource.data.return_signature_url
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'return_time', 'returned_by', 'return_photo_url',
                    'return_signature_url', 'status', 'updated_at'
                  ]);
    }

    function validKeyAudit(data, id) {
      return data.keys().hasOnly([
               'audit_id', 'operator_id', 'account_uid', 'user_name', 'operator_name',
               'site_id', 'action', 'module_name', 'record_id', 'old_value',
               'new_value', 'action_result', 'created_at'
             ])
             && data.keys().hasAll([
               'audit_id', 'operator_id', 'account_uid', 'user_name', 'operator_name',
               'site_id', 'action', 'module_name', 'record_id', 'old_value',
               'new_value', 'action_result', 'created_at'
             ])
             && data.audit_id == id
             && data.operator_id == request.auth.uid
             && data.account_uid == request.auth.uid
             && data.site_id == activeSiteId()
             && data.module_name == 'KeyLogs'
             && data.action in ['KeyCheckout', 'KeyReturn']
             && data.record_id is string && data.record_id.size() > 0 && data.record_id.size() <= 128
             && data.user_name is string && data.user_name.size() > 0 && data.user_name.size() <= 256
             && data.operator_name is string && data.operator_name.size() > 0 && data.operator_name.size() <= 256
             && data.old_value is string && data.old_value.size() <= 64
             && data.new_value is string && data.new_value.size() <= 64
             && data.action_result == 'Success'
             && data.created_at == request.time
             && existsAfter(/databases/$(database)/documents/keyLogs/$(data.record_id))
             && getAfter(/databases/$(database)/documents/keyLogs/$(data.record_id)).data.site_id == data.site_id
             && (data.action != 'KeyReturn'
               || (
                 getAfter(/databases/$(database)/documents/keyLogs/$(data.record_id)).data.status == 'คืนแล้ว'
                 && getAfter(/databases/$(database)/documents/keyLogs/$(data.record_id)).data.return_photo_url is string
                 && getAfter(/databases/$(database)/documents/keyLogs/$(data.record_id)).data.return_photo_url.size() > 0
                 && getAfter(/databases/$(database)/documents/keyLogs/$(data.record_id)).data.return_signature_url is string
                 && getAfter(/databases/$(database)/documents/keyLogs/$(data.record_id)).data.return_signature_url.size() > 0
               ));
    }

    function validPatrolPoint(data, id) {
      return data.keys().hasOnly([
               'patrol_point_id', 'point_name', 'location_detail', 'qr_code_value',
               'required_interval_minutes', 'area', 'building', 'floor', 'sort_order',
               'status', 'site_id', 'created_at', 'updated_at'
             ])
             && data.keys().hasAll([
               'patrol_point_id', 'point_name', 'location_detail', 'qr_code_value',
               'required_interval_minutes', 'status', 'site_id', 'created_at', 'updated_at'
             ])
             && data.patrol_point_id == id
             && data.site_id == activeSiteId()
             && data.point_name is string && data.point_name.size() > 0 && data.point_name.size() <= 256
             && data.location_detail is string && data.location_detail.size() <= 1000
             && data.qr_code_value is string && data.qr_code_value.size() <= 256
             && data.required_interval_minutes is number && data.required_interval_minutes >= 0 && data.required_interval_minutes <= 10080
             && data.status in ['Active', 'Inactive']
             && (data.created_at is timestamp || (data.created_at is string && data.created_at.size() <= 64))
             && data.updated_at is timestamp
             && (!('area' in data) || (data.area is string && data.area.size() <= 128))
             && (!('building' in data) || (data.building is string && data.building.size() <= 128))
             && (!('floor' in data) || (data.floor is string && data.floor.size() <= 64))
             && (!('sort_order' in data) || (data.sort_order is number && data.sort_order >= 0 && data.sort_order <= 100000));
    }

    function validPatrolLogCreate(data, id) {
      return data.keys().hasOnly([
               'patrol_log_id', 'patrol_point_id', 'point_name', 'patrol_point_name',
               'custom_location', 'guard_name', 'shift_type', 'checkin_time',
               'photo_url', 'incident_photo_url', 'evidence_photo_1_url',
               'evidence_photo_2_url', 'evidence_photo_1_file_id', 'evidence_photo_2_file_id',
               'status', 'area_status', 'abnormal_detail',
               'abnormal_reason', 'captured_at_client', 'recorded_by_uid',
               'workflow_status', 'shift_id', 'shift_end_at', 'operational_date',
               'site_id', 'created_at', 'updated_at',
               'revision_number', 'has_corrections'
             ])
             && data.keys().hasAll([
               'patrol_log_id', 'patrol_point_id', 'point_name', 'patrol_point_name',
               'custom_location', 'guard_name', 'shift_type', 'checkin_time',
               'evidence_photo_1_url', 'evidence_photo_1_file_id', 'status', 'area_status',
               'recorded_by_uid', 'workflow_status', 'site_id', 'created_at', 'updated_at'
             ])
             && data.patrol_log_id == id
             && data.site_id == activeSiteId()
             && data.recorded_by_uid == request.auth.uid
             && data.patrol_point_id is string && data.patrol_point_id.size() <= 128
             && data.point_name is string && data.point_name.size() > 0 && data.point_name.size() <= 256
             && data.patrol_point_name is string && data.patrol_point_name.size() > 0 && data.patrol_point_name.size() <= 256
             && data.custom_location is string && data.custom_location.size() <= 500
             && data.guard_name is string && data.guard_name.size() > 0 && data.guard_name.size() <= 256
             && data.shift_type in ['เช้า', 'กลางคืน']
             && data.status in ['ปกติ', 'ผิดปกติ']
             && data.area_status in ['normal', 'abnormal']
             && data.workflow_status == 'completed'
             && (!('revision_number' in data) || data.revision_number == 0)
             && (!('has_corrections' in data) || data.has_corrections == false)
             && data.shift_id is string && data.shift_id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_(DAY|NIGHT)$')
             && (!('shift_end_at' in data) || data.shift_end_at is timestamp)
             && data.operational_date is string && data.operational_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && data.evidence_photo_1_url is string && data.evidence_photo_1_url.matches('^https://drive[.]google[.]com/.*') && data.evidence_photo_1_url.size() <= 4096
             && data.evidence_photo_1_file_id is string && data.evidence_photo_1_file_id.size() >= 10 && data.evidence_photo_1_file_id.size() <= 128
             && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.site_id == data.site_id
             && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.module_name == 'PatrolLogs'
             && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.record_id == id
             && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.media_type == 'patrol_photo_1'
             && validOptionalPatrolPhoto2(data, id)
             && data.checkin_time == request.time && data.created_at == request.time && data.updated_at == request.time
             && (!('captured_at_client' in data) || (data.captured_at_client is string && data.captured_at_client.size() <= 64))
             && (!('abnormal_reason' in data) || (data.abnormal_reason is string && data.abnormal_reason.size() <= 2000))
             && (data.area_status != 'abnormal' || (data.abnormal_reason is string && data.abnormal_reason.size() > 0));
    }

    function validOptionalPatrolPhoto2(data, id) {
      return !data.keys().hasAny([
               'incident_photo_url', 'evidence_photo_2_url', 'evidence_photo_2_file_id'
             ])
             || (
               data.keys().hasAll([
                 'incident_photo_url', 'evidence_photo_2_url', 'evidence_photo_2_file_id'
               ])
               && data.incident_photo_url == data.evidence_photo_2_url
               && data.evidence_photo_2_url is string
               && data.evidence_photo_2_url.matches('^https://drive[.]google[.]com/.*')
               && data.evidence_photo_2_url.size() <= 4096
               && data.evidence_photo_1_url != data.evidence_photo_2_url
               && data.evidence_photo_2_file_id is string
               && data.evidence_photo_2_file_id.size() >= 10
               && data.evidence_photo_2_file_id.size() <= 128
               && data.evidence_photo_1_file_id != data.evidence_photo_2_file_id
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.site_id == data.site_id
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.module_name == 'PatrolLogs'
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.record_id == id
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.media_type == 'patrol_photo_2'
             );
    }

    function validIncidentCreate(data, id) {
      return data.keys().hasOnly([
               'incident_id', 'incident_datetime', 'reported_at', 'location',
               'location_type', 'target_unit_id', 'unit_lookup_status', 'patrol_point_id',
               'location_name_snapshot', 'custom_location', 'incident_type', 'description',
               'photo_url', 'photo_file_id', 'reported_by', 'reporter_name', 'involved_parties',
               'damage_details', 'initial_action', 'shift_leader', 'outcome', 'priority',
               'management_note', 'status', 'incident_status', 'alert_status',
               'recorded_by_uid', 'site_id',
               'created_at', 'updated_at', 'revision_number', 'has_corrections', 'shift_id', 'shift_end_at'
             ])
             && data.keys().hasAll([
               'incident_id', 'incident_datetime', 'reported_at', 'location',
               'location_type', 'location_name_snapshot', 'incident_type', 'description',
               'photo_url', 'photo_file_id', 'reported_by', 'shift_leader', 'priority', 'status',
               'incident_status', 'alert_status', 'recorded_by_uid',
               'site_id', 'created_at', 'updated_at'
             ])
             && data.incident_id == id
             && data.site_id == activeSiteId()
             && data.recorded_by_uid == request.auth.uid
             && data.incident_datetime is timestamp
             && data.reported_at == request.time && data.created_at == request.time && data.updated_at == request.time
             && data.location_type in ['unit', 'patrol_point', 'common_area', 'custom']
             && data.location is string && data.location.size() > 0 && data.location.size() <= 500
             && data.location_name_snapshot is string && data.location_name_snapshot.size() > 0 && data.location_name_snapshot.size() <= 500
             && data.incident_type is string && data.incident_type.size() > 0 && data.incident_type.size() <= 128
             && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
             && data.photo_url is string && data.photo_url.matches('^https://drive[.]google[.]com/.*') && data.photo_url.size() <= 4096
             && data.photo_file_id is string && data.photo_file_id.size() >= 10 && data.photo_file_id.size() <= 128
             && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.site_id == data.site_id
             && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.module_name == 'IncidentReports'
             && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.record_id == id
             && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.media_type == 'incident_photo'
             && data.reported_by is string && data.reported_by.size() > 0 && data.reported_by.size() <= 256
             && data.shift_leader is string && data.shift_leader.size() <= 256
             && data.priority in ['Low', 'Normal', 'High', 'Emergency']
             && data.status == 'แจ้งแล้ว'
             && data.incident_status == 'reported'
             && data.alert_status == 'active'
             && (!('shift_id' in data) || data.shift_id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_(DAY|NIGHT)$'))
             && (!('shift_end_at' in data) || data.shift_end_at is timestamp)
             && (!('revision_number' in data) || data.revision_number == 0)
             && (!('has_corrections' in data) || data.has_corrections == false)
             && (!('target_unit_id' in data) || (data.target_unit_id is string && data.target_unit_id.size() <= 128))
             && (!('patrol_point_id' in data) || (data.patrol_point_id is string && data.patrol_point_id.size() <= 128))
             && (!('custom_location' in data) || (data.custom_location is string && data.custom_location.size() <= 500))
             && (!('reporter_name' in data) || (data.reporter_name is string && data.reporter_name.size() <= 256))
             && (!('involved_parties' in data) || (data.involved_parties is string && data.involved_parties.size() <= 2000))
             && (!('damage_details' in data) || (data.damage_details is string && data.damage_details.size() <= 5000))
             && (!('initial_action' in data) || (data.initial_action is string && data.initial_action.size() <= 5000))
             && (!('outcome' in data) || (data.outcome is string && data.outcome.size() <= 1000));
    }

    // Backward-compatible Admin import path. Operational Guard creates must use
    // validIncidentCreate() and the atomic audit transaction above.
    function validLegacyIncidentImport(data, id) {
      return data.keys().hasOnly([
               'incident_id', 'incident_datetime', 'location', 'target_unit_id',
               'unit_lookup_status', 'incident_type', 'description', 'photo_url',
               'reported_by', 'shift_leader', 'management_note', 'status',
               'severity', 'assigned_to', 'resolved_at', 'site_id', 'created_at', 'updated_at'
             ])
             && data.keys().hasAll([
               'incident_id', 'incident_datetime', 'location', 'incident_type',
               'description', 'reported_by', 'shift_leader', 'status',
               'site_id', 'created_at', 'updated_at'
             ])
             && data.incident_id == id
             && data.site_id == activeSiteId()
             && ((data.incident_datetime is string && data.incident_datetime.size() <= 64)
               || data.incident_datetime is timestamp)
             && data.location is string && data.location.size() > 0 && data.location.size() <= 500
             && data.incident_type is string && data.incident_type.size() > 0 && data.incident_type.size() <= 128
             && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
             && data.reported_by is string && data.reported_by.size() > 0 && data.reported_by.size() <= 256
             && data.shift_leader is string && data.shift_leader.size() <= 256
             && data.status in ['แจ้งแล้ว', 'กำลังดำเนินการ', 'ปิดงานแล้ว']
             && data.created_at == request.time && data.updated_at == request.time
             && (!('photo_url' in data) || (data.photo_url is string && data.photo_url.size() <= 4096))
             && (!('management_note' in data) || (data.management_note is string && data.management_note.size() <= 5000));
    }

    function validIncidentUpdate(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.site_id == activeSiteId()
             && request.resource.data.site_id == resource.data.site_id
             && request.resource.data.incident_id == resource.data.incident_id
             && request.resource.data.incident_datetime == resource.data.incident_datetime
             && request.resource.data.created_at == resource.data.created_at
             && (!('reported_at' in resource.data)
               || request.resource.data.reported_at == resource.data.reported_at)
             && (!('recorded_by_uid' in resource.data)
               || request.resource.data.recorded_by_uid == resource.data.recorded_by_uid)
             && request.resource.data.updated_at == request.time
             && changed.hasOnly([
               'status', 'incident_status', 'alert_status', 'acknowledged_at',
               'acknowledged_by', 'action_started_at', 'action_started_by',
               'resolved_at', 'resolved_by', 'closed_at', 'closed_by',
               'resolution_summary', 'updated_at'
             ])
             && (
               (
                 (!('incident_status' in resource.data) || resource.data.incident_status == 'reported')
                 && request.resource.data.incident_status == 'acknowledged'
                 && request.resource.data.status == resource.data.status
                 && request.resource.data.alert_status == 'acknowledged'
                 && request.resource.data.acknowledged_at == request.time
                 && request.resource.data.acknowledged_by == request.auth.uid
                 && !('acknowledged_at' in resource.data)
                 && changed.hasOnly(['incident_status', 'alert_status', 'acknowledged_at', 'acknowledged_by', 'updated_at'])
                 && existsAfter(/databases/$(database)/documents/auditLogs/$(('INCIDENT_ACKNOWLEDGE_' + id)))
               )
               || (
                 resource.data.incident_status == 'acknowledged'
                 && request.resource.data.incident_status == 'in_progress'
                 && request.resource.data.status == 'กำลังดำเนินการ'
                 && request.resource.data.alert_status == 'acknowledged'
                 && request.resource.data.action_started_at == request.time
                 && request.resource.data.action_started_by == request.auth.uid
                 && !('action_started_at' in resource.data)
                 && changed.hasOnly(['status', 'incident_status', 'action_started_at', 'action_started_by', 'updated_at'])
                 && existsAfter(/databases/$(database)/documents/auditLogs/$(('INCIDENT_START_' + id)))
               )
               || (
                 resource.data.incident_status == 'in_progress'
                 && request.resource.data.incident_status == 'resolved'
                 && request.resource.data.status == 'ปิดงานแล้ว'
                 && request.resource.data.alert_status == 'cleared'
                 && request.resource.data.resolved_at == request.time
                 && request.resource.data.resolved_by == request.auth.uid
                 && request.resource.data.resolution_summary is string
                 && request.resource.data.resolution_summary.size() > 0
                 && request.resource.data.resolution_summary.size() <= 5000
                 && !('resolved_at' in resource.data)
                 && changed.hasOnly(['status', 'incident_status', 'alert_status', 'resolved_at', 'resolved_by', 'resolution_summary', 'updated_at'])
                 && existsAfter(/databases/$(database)/documents/auditLogs/$(('INCIDENT_RESOLVE_' + id)))
               )
               || (
                 resource.data.incident_status == 'resolved'
                 && request.resource.data.incident_status == 'closed'
                 && request.resource.data.status == 'ปิดงานแล้ว'
                 && request.resource.data.alert_status == 'cleared'
                 && request.resource.data.closed_at == request.time
                 && request.resource.data.closed_by == request.auth.uid
                 && request.resource.data.resolution_summary is string
                 && request.resource.data.resolution_summary.size() > 0
                 && request.resource.data.resolution_summary.size() <= 5000
                 && !('closed_at' in resource.data)
                 && changed.hasOnly(['incident_status', 'closed_at', 'closed_by', 'resolution_summary', 'updated_at'])
                 && existsAfter(/databases/$(database)/documents/auditLogs/$(('INCIDENT_CLOSE_' + id)))
               )
             );
    }

    function correctionWindowMinutes() {
      let path = /databases/$(database)/documents/systemSettings/revisionPolicy;
      return exists(path)
             && get(path).data.guard_timeout_minutes is int
             && get(path).data.guard_timeout_minutes >= 1
             && get(path).data.guard_timeout_minutes <= 1440
        ? get(path).data.guard_timeout_minutes : 30;
    }

    function canCorrectRecord(data, moduleName) {
      return isActiveUser()
             && data.site_id == activeSiteId()
             && (
               ownProfile().role in ['Manager', 'Admin']
               || (ownProfile().role == 'ShiftHead'
                 && (('shift_end_at' in data && request.time < data.shift_end_at)
                   || (!('shift_end_at' in data) && request.time <= data.created_at + duration.value(12, 'h'))))
               || (ownProfile().role == 'Guard'
                 && data.recorded_by_uid == request.auth.uid
                 && request.time <= data.created_at + duration.value(correctionWindowMinutes(), 'm')
                 && (moduleName != 'IncidentReports'
                   || (!('incident_status' in data) || data.incident_status == 'reported'))
                 && (moduleName != 'PatrolLogs'
                   || request.time <= data.created_at + duration.value(12, 'h')))
             );
    }

    function validCorrectionMetadata(data, changed, moduleName, recordId) {
      let oldNumber = ('revision_number' in resource.data) ? resource.data.revision_number : 0;
      return 'revision_number' in data
             && 'last_revision_id' in data
             && data.revision_number == oldNumber + 1
             && data.last_revision_id is string && data.last_revision_id.size() > 0 && data.last_revision_id.size() <= 128
             && data.last_edited_at == request.time
             && data.last_edited_by_uid == request.auth.uid
             && data.last_edited_by_name == ownProfile().operator_name
             && data.has_corrections == true
             && data.updated_at == request.time
             && ((moduleName == 'IncidentReports'
                   && existsAfter(/databases/$(database)/documents/incidentReports/$(recordId)/revisions/$(data.last_revision_id)))
               || (moduleName == 'PatrolLogs'
                   && existsAfter(/databases/$(database)/documents/patrolLogs/$(recordId)/revisions/$(data.last_revision_id))));
    }

    function validIncidentCorrection(id) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return canCorrectRecord(resource.data, 'IncidentReports')
             && data.site_id == resource.data.site_id
             && data.incident_id == resource.data.incident_id
             && data.created_at == resource.data.created_at
             && data.reported_at == resource.data.reported_at
             && data.recorded_by_uid == resource.data.recorded_by_uid
             && changed.hasOnly([
               'incident_datetime', 'incident_type', 'location', 'description', 'priority',
               'photo_url', 'photo_file_id', 'remarks', 'revision_number', 'last_revision_id',
               'last_edited_at', 'last_edited_by_uid', 'last_edited_by_name', 'has_corrections', 'updated_at'
             ])
             && changed.hasAny(['incident_datetime', 'incident_type', 'location', 'description', 'priority', 'photo_url', 'photo_file_id', 'remarks'])
             && (!changed.hasAny(['incident_datetime']) || data.incident_datetime is timestamp)
             && (!changed.hasAny(['description']) || (data.description is string && data.description.size() > 0 && data.description.size() <= 10000))
             && (!changed.hasAny(['location']) || (data.location is string && data.location.size() > 0 && data.location.size() <= 500))
             && (!changed.hasAny(['incident_type']) || (data.incident_type is string && data.incident_type.size() > 0 && data.incident_type.size() <= 128))
             && (!changed.hasAny(['priority']) || data.priority in ['Low', 'Normal', 'High', 'Emergency'])
             && (!changed.hasAny(['remarks']) || (data.remarks is string && data.remarks.size() <= 5000))
             && changed.hasAny(['photo_url']) == changed.hasAny(['photo_file_id'])
             && (!changed.hasAny(['photo_url']) || (data.photo_url is string && data.photo_url.matches('^https://drive[.]google[.]com/.*')))
             && (!changed.hasAny(['photo_file_id']) || (
               data.photo_file_id is string
               && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.site_id == data.site_id
               && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.module_name == 'IncidentReports'
               && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.record_id == id
               && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.media_type == 'incident_photo'
               && get(/databases/$(database)/documents/mediaUploads/$(data.photo_file_id)).data.media_url == data.photo_url))
             && validCorrectionMetadata(data, changed, 'IncidentReports', id);
    }

    function validPatrolCorrection(id) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return canCorrectRecord(resource.data, 'PatrolLogs')
             && data.site_id == resource.data.site_id
             && data.patrol_log_id == resource.data.patrol_log_id
             && data.created_at == resource.data.created_at
             && data.checkin_time == resource.data.checkin_time
             && data.recorded_by_uid == resource.data.recorded_by_uid
             && changed.hasOnly([
               'patrol_point_name', 'custom_location', 'abnormal_reason', 'remarks',
               'evidence_photo_1_url', 'evidence_photo_1_file_id', 'evidence_photo_2_url', 'evidence_photo_2_file_id',
               'revision_number', 'last_revision_id', 'last_edited_at', 'last_edited_by_uid',
               'last_edited_by_name', 'has_corrections', 'updated_at'
             ])
             && changed.hasAny(['patrol_point_name', 'custom_location', 'abnormal_reason', 'remarks', 'evidence_photo_1_url', 'evidence_photo_1_file_id', 'evidence_photo_2_url', 'evidence_photo_2_file_id'])
             && (!changed.hasAny(['patrol_point_name']) || (data.patrol_point_name is string && data.patrol_point_name.size() > 0 && data.patrol_point_name.size() <= 256))
             && (!changed.hasAny(['custom_location']) || (data.custom_location is string && data.custom_location.size() <= 500))
             && (!changed.hasAny(['abnormal_reason']) || (data.abnormal_reason is string && data.abnormal_reason.size() <= 2000))
             && (!changed.hasAny(['remarks']) || (data.remarks is string && data.remarks.size() <= 5000))
             && changed.hasAny(['evidence_photo_1_url']) == changed.hasAny(['evidence_photo_1_file_id'])
             && changed.hasAny(['evidence_photo_2_url']) == changed.hasAny(['evidence_photo_2_file_id'])
             && (!changed.hasAny(['evidence_photo_1_url']) || data.evidence_photo_1_url.matches('^https://drive[.]google[.]com/.*'))
             && (!changed.hasAny(['evidence_photo_2_url']) || data.evidence_photo_2_url.matches('^https://drive[.]google[.]com/.*'))
             && (!changed.hasAny(['evidence_photo_1_file_id']) || (
               get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.site_id == data.site_id
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.module_name == 'PatrolLogs'
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.record_id == id
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.media_type == 'patrol_photo_1'
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_1_file_id)).data.media_url == data.evidence_photo_1_url))
             && (!changed.hasAny(['evidence_photo_2_file_id']) || (
               get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.site_id == data.site_id
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.module_name == 'PatrolLogs'
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.record_id == id
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.media_type == 'patrol_photo_2'
               && get(/databases/$(database)/documents/mediaUploads/$(data.evidence_photo_2_file_id)).data.media_url == data.evidence_photo_2_url))
             && validCorrectionMetadata(data, changed, 'PatrolLogs', id);
    }

    function validIncidentRevisionValues(data, recordId) {
      let old = get(/databases/$(database)/documents/incidentReports/$(recordId)).data;
      let current = getAfter(/databases/$(database)/documents/incidentReports/$(recordId)).data;
      return (!data.changed_fields.hasAny(['incident_datetime']) || (data.before.incident_datetime == old.incident_datetime && data.after.incident_datetime == current.incident_datetime))
             && (!data.changed_fields.hasAny(['incident_type']) || (data.before.incident_type == old.incident_type && data.after.incident_type == current.incident_type))
             && (!data.changed_fields.hasAny(['location']) || (data.before.location == old.location && data.after.location == current.location))
             && (!data.changed_fields.hasAny(['description']) || (data.before.description == old.description && data.after.description == current.description))
             && (!data.changed_fields.hasAny(['priority']) || (data.before.priority == old.priority && data.after.priority == current.priority))
             && (!data.changed_fields.hasAny(['photo_url']) || (data.before.photo_url == old.photo_url && data.after.photo_url == current.photo_url))
             && (!data.changed_fields.hasAny(['photo_file_id']) || (data.before.photo_file_id == old.photo_file_id && data.after.photo_file_id == current.photo_file_id))
             && (!data.changed_fields.hasAny(['remarks']) || (
               ((!('remarks' in old) && data.before.remarks == null) || data.before.remarks == old.remarks)
               && data.after.remarks == current.remarks));
    }

    function validPatrolRevisionValues(data, recordId) {
      let old = get(/databases/$(database)/documents/patrolLogs/$(recordId)).data;
      let current = getAfter(/databases/$(database)/documents/patrolLogs/$(recordId)).data;
      return (!data.changed_fields.hasAny(['patrol_point_name']) || (data.before.patrol_point_name == old.patrol_point_name && data.after.patrol_point_name == current.patrol_point_name))
             && (!data.changed_fields.hasAny(['custom_location']) || (data.before.custom_location == old.custom_location && data.after.custom_location == current.custom_location))
             && (!data.changed_fields.hasAny(['abnormal_reason']) || (
               ((!('abnormal_reason' in old) && data.before.abnormal_reason == null)
                 || (('abnormal_reason' in old) && data.before.abnormal_reason == old.abnormal_reason))
               && data.after.abnormal_reason == current.abnormal_reason))
             && (!data.changed_fields.hasAny(['evidence_photo_1_url']) || (data.before.evidence_photo_1_url == old.evidence_photo_1_url && data.after.evidence_photo_1_url == current.evidence_photo_1_url))
             && (!data.changed_fields.hasAny(['evidence_photo_1_file_id']) || (data.before.evidence_photo_1_file_id == old.evidence_photo_1_file_id && data.after.evidence_photo_1_file_id == current.evidence_photo_1_file_id))
             && (!data.changed_fields.hasAny(['evidence_photo_2_url']) || (((!('evidence_photo_2_url' in old) && data.before.evidence_photo_2_url == null) || data.before.evidence_photo_2_url == old.evidence_photo_2_url) && data.after.evidence_photo_2_url == current.evidence_photo_2_url))
             && (!data.changed_fields.hasAny(['evidence_photo_2_file_id']) || (((!('evidence_photo_2_file_id' in old) && data.before.evidence_photo_2_file_id == null) || data.before.evidence_photo_2_file_id == old.evidence_photo_2_file_id) && data.after.evidence_photo_2_file_id == current.evidence_photo_2_file_id))
             && (!data.changed_fields.hasAny(['remarks']) || (((!('remarks' in old) && data.before.remarks == null) || data.before.remarks == old.remarks) && data.after.remarks == current.remarks));
    }

    function validRevisionCreate(data, revisionId, recordId, moduleName) {
      return data.keys().hasOnly([
               'revision_id', 'revision_number', 'record_id', 'module_name', 'site_id', 'changed_fields',
               'before', 'after', 'reason', 'edited_by_uid', 'edited_by_name', 'edited_by_role', 'edited_at', 'audit_id'
             ])
             && data.revision_id == revisionId && data.record_id == recordId && data.module_name == moduleName
             && data.site_id == activeSiteId()
             && ((moduleName == 'IncidentReports'
                   && data.site_id == getAfter(/databases/$(database)/documents/incidentReports/$(recordId)).data.site_id
                   && data.revision_number == getAfter(/databases/$(database)/documents/incidentReports/$(recordId)).data.revision_number
                   && getAfter(/databases/$(database)/documents/incidentReports/$(recordId)).data.last_revision_id == revisionId)
               || (moduleName == 'PatrolLogs'
                   && data.site_id == getAfter(/databases/$(database)/documents/patrolLogs/$(recordId)).data.site_id
                   && data.revision_number == getAfter(/databases/$(database)/documents/patrolLogs/$(recordId)).data.revision_number
                   && getAfter(/databases/$(database)/documents/patrolLogs/$(recordId)).data.last_revision_id == revisionId))
             && data.changed_fields is list && data.changed_fields.size() > 0
             && data.before is map && data.after is map
             && data.before.keys().hasOnly(data.changed_fields) && data.before.keys().hasAll(data.changed_fields)
             && data.after.keys().hasOnly(data.changed_fields) && data.after.keys().hasAll(data.changed_fields)
             && ((moduleName == 'IncidentReports' && validIncidentRevisionValues(data, recordId))
               || (moduleName == 'PatrolLogs' && validPatrolRevisionValues(data, recordId)))
             && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 2000
             && data.edited_by_uid == request.auth.uid
             && data.edited_by_name == ownProfile().operator_name
             && data.edited_by_role == ownProfile().role
             && data.edited_at == request.time
             && data.audit_id is string
             && existsAfter(/databases/$(database)/documents/auditLogs/$(data.audit_id));
    }

    function validCorrectionAudit(data, id) {
      return data.keys().hasOnly([
               'audit_id', 'operator_id', 'account_uid', 'user_name', 'operator_name', 'site_id',
               'action', 'module_name', 'record_id', 'revision_number', 'changed_fields', 'reason',
               'old_value', 'new_value', 'action_result', 'created_at'
             ])
             && data.audit_id == id && data.operator_id == request.auth.uid && data.account_uid == request.auth.uid
             && data.site_id == activeSiteId() && data.action in ['IncidentCorrection', 'PatrolCorrection']
             && data.module_name in ['IncidentReports', 'PatrolLogs']
             && data.revision_number is int && data.revision_number > 0
             && data.changed_fields is list && data.changed_fields.size() > 0
             && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 2000
             && data.action_result == 'Success' && data.created_at == request.time
             && ((data.module_name == 'IncidentReports'
                   && getAfter(/databases/$(database)/documents/incidentReports/$(data.record_id)).data.revision_number == data.revision_number
                   && getAfter(/databases/$(database)/documents/incidentReports/$(data.record_id)/revisions/$(getAfter(/databases/$(database)/documents/incidentReports/$(data.record_id)).data.last_revision_id)).data.audit_id == id)
               || (data.module_name == 'PatrolLogs'
                   && getAfter(/databases/$(database)/documents/patrolLogs/$(data.record_id)).data.revision_number == data.revision_number
                   && getAfter(/databases/$(database)/documents/patrolLogs/$(data.record_id)/revisions/$(getAfter(/databases/$(database)/documents/patrolLogs/$(data.record_id)).data.last_revision_id)).data.audit_id == id));
    }

    function validOperationalAudit(data, id) {
      return data.keys().hasOnly([
               'audit_id', 'operator_id', 'account_uid', 'user_name', 'operator_name',
               'site_id', 'action', 'module_name', 'record_id', 'old_value',
               'new_value', 'action_result', 'created_at'
             ])
             && data.audit_id == id
             && data.operator_id == request.auth.uid
             && data.account_uid == request.auth.uid
             && data.site_id == activeSiteId()
             && data.module_name in ['PatrolLogs', 'IncidentReports']
             && data.action in [
               'PatrolCheckin', 'IncidentReported', 'Incident:acknowledge',
               'Incident:start', 'Incident:resolve', 'Incident:close'
             ]
             && data.record_id is string && data.record_id.size() > 0 && data.record_id.size() <= 128
             && data.user_name is string && data.user_name.size() > 0 && data.user_name.size() <= 256
             && data.operator_name is string && data.operator_name.size() > 0 && data.operator_name.size() <= 256
             && data.old_value is string && data.old_value.size() <= 64
             && data.new_value is string && data.new_value.size() <= 64
             && data.action_result == 'Success'
             && data.created_at == request.time
             && ((data.module_name == 'PatrolLogs'
                    && existsAfter(/databases/$(database)/documents/patrolLogs/$(data.record_id))
                    && getAfter(/databases/$(database)/documents/patrolLogs/$(data.record_id)).data.site_id == data.site_id)
               || (data.module_name == 'IncidentReports'
                    && existsAfter(/databases/$(database)/documents/incidentReports/$(data.record_id))
                    && getAfter(/databases/$(database)/documents/incidentReports/$(data.record_id)).data.site_id == data.site_id));
    }

    match /loginDirectory/{username} {
      allow get: if isAdmin();
      allow list: if false;

      // One-time first Admin bootstrap.
      allow create: if signedIn()
                    && bootstrapOpen()
                    && username == 'admin'
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'Active'
                    && existsAfter(/databases/$(database)/documents/systemSettings/authBootstrap);

      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // One-time first Admin profile.
      allow create: if signedIn()
                    && bootstrapOpen()
                    && request.auth.uid == uid
                    && request.resource.data.username == 'admin'
                    && request.resource.data.role == 'Admin'
                    && request.resource.data.status == 'Active'
                    && existsAfter(/databases/$(database)/documents/loginDirectory/admin)
                    && existsAfter(/databases/$(database)/documents/systemSettings/authBootstrap);

      allow create, update, delete: if isAdmin();
    }

    match /systemSettings/authBootstrap {
      allow get: if true;
      allow create: if signedIn()
                    && bootstrapOpen()
                    && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
      allow update, delete: if isAdmin();
    }

    match /systemSettings/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /parkingCards/{id} {
      allow read: if isAdmin() || (canProcessVehicleExit() && resource.data.site_id == activeSiteId());
      allow create: if canManageParkingCards()
                    && request.resource.data.firestore_document_id == id
                    && request.resource.data.site_id == activeSiteId()
                    && request.resource.data.status in ['Available', 'Suspended']
                    && !('current_vehicle_plate' in request.resource.data)
                    && !('current_vehicle_log_id' in request.resource.data)
                    && request.resource.data.keys().hasAll(['card_number_normalized', 'qr_code_normalized', 'status_normalized'])
                    && validReplacementCreate(id)
                    && validParkingCard(request.resource.data);
      allow update: if (request.resource.data.card_id == resource.data.card_id
                        && request.resource.data.site_id == resource.data.site_id
                        && request.resource.data.site_id == activeSiteId()
                        && allowedParkingCardTransition()
                        && validReplacementUpdate(id)
                        && (
                          (resource.data.status in ['InUse', 'In Use', 'ใช้งานอยู่']
                            && request.resource.data.status in ['Available', 'Lost']
                            && validParkingCardUpdateData()
                            && guardParkingCardTransition())
                          || (validParkingCard(request.resource.data)
                            && (vehicleSessionCardTransition() || guardParkingCardTransition() || adminParkingCardTransition()))
                        ))
                    || adminParkingCardMigration(id);
      allow delete: if canManageParkingCards()
                    && resource.data.site_id == activeSiteId()
                    && resource.data.status != 'InUse'
                    && !(resource.data.status in ['Lost', 'Cancelled', 'Retired', 'Replaced'])
                    && (!('current_vehicle_plate' in resource.data) || resource.data.current_vehicle_plate == '')
                    && !('replaced_by_card_id' in resource.data)
                    && !('replaced_by_document_id' in resource.data)
                    && !('replacement_for_card_id' in resource.data)
                    && !('replacement_for_document_id' in resource.data);
    }

    match /vehicleSessions/{id} {
      allow read: if canProcessVehicleExit() && resource.data.site_id == activeSiteId();
      allow create: if canProcessVehicleExit()
                    && request.resource.data.session_id == id
                    && request.resource.data.opened_by == request.auth.uid
                    && request.resource.data.last_updated_by == request.auth.uid
                    && request.resource.data.sessionVersion == 1
                    && request.resource.data.assignedTo == request.auth.uid
                    && request.resource.data.assignedBy == request.auth.uid
                    && validVehicleSession(request.resource.data)
                    && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.status == 'Reserved'
                    && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.current_vehicle_session_id == id;
      allow update: if (canUpdateVehicleSession()
                    && request.resource.data.last_updated_by == request.auth.uid
                    && request.resource.data.sessionVersion == resource.data.sessionVersion + 1
                    && validAssignmentVersion()
                    && (request.resource.data.assignedTo == ''
                      || request.resource.data.assignedTo == null
                      || request.resource.data.assignedTo == request.auth.uid
                      || activeOperatorAtSite(request.resource.data.assignedTo, resource.data.site_id))
                    && validVehicleSessionUpdate())
                    || (request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['queueSchemaVersion', 'queue_migrated_at', 'queue_migrated_by'])
                        && adminQueueMigration());
      allow delete: if isAdmin() && resource.data.site_id == activeSiteId();

      match /activities/{activityId} {
        allow read: if canProcessVehicleExit()
                    && get(/databases/$(database)/documents/vehicleSessions/$(id)).data.site_id == activeSiteId();
        allow create: if canProcessVehicleExit()
                      && getAfter(/databases/$(database)/documents/vehicleSessions/$(id)).data.site_id == activeSiteId()
                      && (
                        !(getAfter(/databases/$(database)/documents/vehicleSessions/$(id)).data.status in ['Completed', 'Cancelled'])
                        || (
                          request.resource.data.action == 'VehicleExitCompleted'
                          && get(/databases/$(database)/documents/vehicleSessions/$(id)).data.status == 'InProgress'
                          && getAfter(/databases/$(database)/documents/vehicleSessions/$(id)).data.status == 'Completed'
                        )
                      )
                      && validSessionActivity(request.resource.data, id, activityId);
        allow update, delete: if false;
      }
    }

    match /vehicleLogs/{id} {
      allow read: if isAdmin() || (canProcessVehicleExit() && resource.data.site_id == activeSiteId());
      allow create: if isActiveUser()
                    && request.resource.data.log_id == id
                    && request.resource.data.site_id == activeSiteId()
                    && request.resource.data.account_uid == request.auth.uid
                    && request.resource.data.operator_id == request.auth.uid
                    && request.resource.data.status == 'กำลังจอด'
                    && validVehicleLog(request.resource.data)
                    && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.status == 'InUse'
                    && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.current_vehicle_log_id == id
                    && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.card_number == request.resource.data.card_number
                    && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.site_id == request.resource.data.site_id;
      allow update: if (
                      validActiveVehicleLogDetailUpdate(id)
                      || (
                        validVehicleExitTransition()
                        && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.status in ['Available', 'Lost']
                        && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.current_vehicle_log_id == ''
                        && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.related_vehicle_log_id == id
                        && getAfter(/databases/$(database)/documents/parkingCards/$(request.resource.data.parking_card_id)).data.site_id == request.resource.data.site_id
                      )
                    );
      allow delete: if isAdmin() && resource.data.site_id == activeSiteId();
    }

    match /contractorLogs/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /keyLogs/{id} {
      allow get: if isActiveUser()
                 && (!exists(/databases/$(database)/documents/keyLogs/$(id))
                   || resource.data.site_id == activeSiteId());
      allow list: if isActiveUser() && resource.data.site_id == activeSiteId();
      allow create: if isActiveUser() && validKeyLogCreate(request.resource.data, id);
      allow update: if isActiveUser() && validKeyReturn();
      allow delete: if isAdmin() && resource.data.site_id == activeSiteId();
    }

    match /patrolPoints/{id} {
      allow read: if isActiveUser() && resource.data.site_id == activeSiteId();
      allow create: if canManageUnits()
                    && validPatrolPoint(request.resource.data, id)
                    && request.resource.data.created_at == request.time
                    && request.resource.data.updated_at == request.time;
      allow update: if canManageUnits()
                    && resource.data.site_id == activeSiteId()
                    && request.resource.data.site_id == resource.data.site_id
                    && request.resource.data.patrol_point_id == resource.data.patrol_point_id
                    && validPatrolPoint(request.resource.data, id)
                    && request.resource.data.created_at == resource.data.created_at
                    && request.resource.data.updated_at == request.time;
      allow delete: if isAdmin() && resource.data.site_id == activeSiteId();
    }

    match /patrolLogs/{id} {
      allow get: if isActiveUser()
                 && (!exists(/databases/$(database)/documents/patrolLogs/$(id))
                   || resource.data.site_id == activeSiteId());
      allow list: if isActiveUser() && resource.data.site_id == activeSiteId();
      allow create: if canProcessVehicleExit() && validPatrolLogCreate(request.resource.data, id);
      allow update: if validPatrolCorrection(id);
      allow delete: if isAdmin() && resource.data.site_id == activeSiteId();

      match /revisions/{revisionId} {
        allow read: if isActiveUser() && resource.data.site_id == activeSiteId();
        allow create: if validRevisionCreate(request.resource.data, revisionId, id, 'PatrolLogs');
        allow update, delete: if false;
      }
    }

    match /incidentReports/{id} {
      allow get: if isActiveUser()
                 && (!exists(/databases/$(database)/documents/incidentReports/$(id))
                   || resource.data.site_id == activeSiteId());
      allow list: if isActiveUser() && resource.data.site_id == activeSiteId();
      allow create: if (canProcessVehicleExit() && validIncidentCreate(request.resource.data, id))
                    || (isAdmin() && validLegacyIncidentImport(request.resource.data, id));
      allow update: if (canManageUnits() && validIncidentUpdate(id)) || validIncidentCorrection(id);
      allow delete: if isAdmin() && resource.data.site_id == activeSiteId();

      match /revisions/{revisionId} {
        allow read: if isActiveUser() && resource.data.site_id == activeSiteId();
        allow create: if validRevisionCreate(request.resource.data, revisionId, id, 'IncidentReports');
        allow update, delete: if false;
      }
    }

    match /blacklist/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /dailyReports/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin()
                  || (canManageParkingCards() && resource.data.module_name == 'ParkingCards' && resource.data.site_id == activeSiteId())
                  || (canProcessVehicleExit() && resource.data.module_name == 'VehicleSessions' && resource.data.site_id == activeSiteId());
      allow create: if isActiveUser()
                    && request.resource.data.audit_id == id
                    && ((request.resource.data.module_name == 'ParkingCards' && validParkingAudit(request.resource.data))
                      || (request.resource.data.module_name == 'units' && validUnitAudit(request.resource.data))
                      || (request.resource.data.module_name == 'KeyLogs' && validKeyAudit(request.resource.data, id))
                      || (request.resource.data.module_name in ['PatrolLogs', 'IncidentReports'] && validOperationalAudit(request.resource.data, id))
                      || (request.resource.data.action in ['IncidentCorrection', 'PatrolCorrection'] && validCorrectionAudit(request.resource.data, id))
                      || !(request.resource.data.module_name in ['ParkingCards', 'units', 'KeyLogs', 'PatrolLogs', 'IncidentReports']));
      allow update, delete: if false;
    }

    match /parkingCardHistory/{id} {
      allow read: if isActiveUser() && resource.data.site_id == activeSiteId();
      allow create: if isActiveUser()
                    && request.resource.data.history_id == id
                    && validParkingCardHistory(request.resource.data);
      allow update, delete: if false;
    }

    match /siteAnalyticsDaily/{dailyId} {
      allow read: if isActiveUser()
                  && ownProfile().role in ['ShiftHead', 'Manager', 'Admin']
                  && resource.data.site_id == activeSiteId();
      allow create, update, delete: if false;

      match /contributions/{contributionId} {
        allow read: if isActiveUser()
                    && ownProfile().role in ['Manager', 'Admin']
                    && get(/databases/$(database)/documents/siteAnalyticsDaily/$(dailyId)).data.site_id == activeSiteId();
        allow create, update, delete: if false;
      }
    }

    match /keys/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /units/{id} {
      allow read: if isActiveUser()
                  && resource.data.site_id == activeSiteId()
                  && (resource.data.status == 'Active' || canManageUnits());
      allow create: if canManageUnits()
                    && request.resource.data.firestore_document_id == id
                    && id.matches('^unit_[0-9a-f]{64}$')
                    && request.resource.data.site_id == activeSiteId()
                    && validUnit(request.resource.data);
      allow update: if canManageUnits()
                    && request.resource.data.unit_id == resource.data.unit_id
                    && (!('firestore_document_id' in resource.data) || request.resource.data.firestore_document_id == resource.data.firestore_document_id)
                    && request.resource.data.firestore_document_id == id
                    && request.resource.data.site_id == resource.data.site_id
                    && request.resource.data.site_id == activeSiteId()
                    && request.resource.data.created_at == resource.data.created_at
                    && validUnit(request.resource.data);
      allow delete: if false;
    }

    match /units_archive/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accounts/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /operators/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /operatorCredentials/{username} {
      allow read, write: if false;
    }

    match /operatorLoginAttempts/{username} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
