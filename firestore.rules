rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return ownProfileExists() && ownProfile().status == 'Active';
    }

    function isAdmin() {
      return isActiveUser() && ownProfile().role == 'Admin';
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/systemSettings/authBootstrap);
    }

    match /loginDirectory/{username} {
      // Required so the login page can convert username -> internal Firebase email.
      allow get: if true;
      allow list: if false;

      // One-time first Admin bootstrap.
      allow create: if signedIn()
                    && bootstrapOpen()
                    && username == 'admin'
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'Active'
                    && existsAfter(/databases/$(database)/documents/systemSettings/authBootstrap);

      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // One-time first Admin profile.
      allow create: if signedIn()
                    && bootstrapOpen()
                    && request.auth.uid == uid
                    && request.resource.data.username == 'admin'
                    && request.resource.data.role == 'Admin'
                    && request.resource.data.status == 'Active'
                    && existsAfter(/databases/$(database)/documents/loginDirectory/admin)
                    && existsAfter(/databases/$(database)/documents/systemSettings/authBootstrap);

      allow create, update, delete: if isAdmin();
    }

    match /systemSettings/authBootstrap {
      allow get: if true;
      allow create: if signedIn()
                    && bootstrapOpen()
                    && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
      allow update, delete: if isAdmin();
    }

    match /systemSettings/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /parkingCards/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /vehicleLogs/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /contractorLogs/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /keyLogs/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /patrolPoints/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /patrolLogs/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /incidentReports/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /blacklist/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /dailyReports/{id} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    match /keys/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /units/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /units_archive/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accounts/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /operators/{id} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
